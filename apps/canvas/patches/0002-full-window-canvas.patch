+<script setup lang="ts">
+import { getLocalWorkspace } from '@/app/document/local-workspace'
+import { useEditorStore } from '@/app/editor/active-store'
+import AppButton from '@/components/ui/button/AppButton.vue'
+import AppAlert from '@/components/ui/feedback/AppAlert.vue'
+import { localWorkspace } from '@/theme/local-workspace'
+
+const workspace = getLocalWorkspace(useEditorStore())
+const { busy, error, status, operations, upload, importFile, retryUpload, exportCurrent, refresh, resume, forgetUpload, applyLayout } = workspace.packages
+const styles = localWorkspace()
+function selectFile(event: Event) {
+  if (!(event.target instanceof HTMLInputElement)) return
+  const file = event.target.files?.[0]
+  event.target.value = ''
+  if (file) void importFile(file)
+}
+</script>
+
+<template>
+  <details :class="styles.directory()">
+    <summary>作品包</summary>
+    <p :class="styles.status()">包含整张画布与历史、文件关联和布局，不包含外部原件。</p>
+    <div :class="styles.actions()">
+      <AppButton :disabled="busy || workspace.busy.value || workspace.scanBusy.value" @click="exportCurrent">导出作品包</AppButton>
+      <AppButton :disabled="busy" @click="refresh">导入记录</AppButton>
+    </div>
+    <input type="file" accept=".oscanvas" aria-label="选择作品包导入" :class="styles.status()"
+      :disabled="busy || Boolean(upload) || workspace.busy.value || workspace.scanBusy.value" @change="selectFile" />
+    <div v-if="upload" :class="styles.actions()">
+      <AppButton :disabled="busy" @click="retryUpload">重试导入 {{ upload.file.name }}</AppButton>
+      <AppButton :disabled="busy" @click="forgetUpload">选择另一个作品包</AppButton>
+    </div>
+    <p v-if="status" role="status" :class="styles.status()" data-slot="package-status">{{ status }}</p>
+    <AppAlert v-if="error" tone="error" heading="作品包" :description="error" />
+    <div v-if="operations.length" :class="styles.list()" aria-label="作品包导入记录">
+      <div v-for="operation in operations" :key="operation.operationId" :class="styles.directory()">
+        <p :class="styles.status()">{{ operation.canvasId }} · {{ operation.state === 'complete' ? '已导入' : '待继续' }}</p>
+        <AppButton v-if="operation.state === 'prepared'" :disabled="busy" @click="resume(operation.operationId)">继续导入作品</AppButton>
+        <AppButton v-if="operation.result" :disabled="busy" @click="applyLayout(operation.result.layout)">应用包内布局</AppButton>
+      </div>
+    </div>
+  </details>
+</template>
diff --git a/src/components/editor/LocalWorkspacePanel.vue b/src/components/editor/LocalWorkspacePanel.vue
