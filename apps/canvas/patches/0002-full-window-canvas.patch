 export class SceneGraph {
   nodes = new Map<string, SceneNode>()
+  // Per-view exclusion is transient: never written to nodes, files, or history.
+  private viewHiddenNodes = new Set<string>()
+  viewVisibilityVersion = 0
+
+  setViewHiddenNodes(ids: ReadonlySet<string>): boolean {
+    if (ids.size === this.viewHiddenNodes.size && [...ids].every(id => this.viewHiddenNodes.has(id))) return false
+    this.viewHiddenNodes = new Set(ids)
+    this.viewVisibilityVersion++
+    return true
+  }
+
+  isViewHidden(id: string): boolean {
+    return this.viewHiddenNodes.size > 0 && Boolean(this.closest(id, node => this.viewHiddenNodes.has(node.id)))
