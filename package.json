{
  "name": "personal-ai-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test --test-timeout=180000 tests/*.test.ts",
    "test:serial": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tests-serial.ps1",
    "probe:pi": "tsx scripts/probe-pi.ts",
    "test:pi-long-task": "tsx scripts/pi-long-task-qa.ts",
    "test:pi-runtime-ui": "vite build --outDir output/pi-parity-build && tsx scripts/pi-runtime-ui-qa.ts",
    "test:pi-steering-ui": "vite build --outDir output/pi-parity-build && tsx scripts/pi-steering-ui-qa.ts",
    "test:pi-mcp-ui": "vite build --outDir output/pi-parity-build && tsx scripts/pi-mcp-ui-qa.ts",
    "test:pi-settings-ui": "vite build --outDir output/pi-parity-build && tsx scripts/pi-settings-ui-qa.ts",
    "test:pi-mcp-login-ui": "vite build --outDir output/pi-parity-build && tsx scripts/pi-mcp-login-ui-qa.ts",
    "test:pi-stream-ui": "vite build --outDir output/pi-parity-build && tsx scripts/pi-stream-ui-qa.ts",
    "test:pi-budget-ui": "vite build --outDir output/pi-parity-build && tsx scripts/pi-budget-ui-qa.ts",
    "test:pi-sweep-ui": "vite build --outDir output/pi-parity-build && tsx scripts/pi-sweep-ui-qa.ts",
    "test:workbench-ui": "vite build --outDir output/workbench-build && tsx scripts/workbench-ui-qa.ts && tsx scripts/workbench-layout-qa.ts && tsx scripts/workbench-appearance-qa.ts",
    "backup": "tsx scripts/backup.ts",
    "node": "tsx scripts/local-node.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@sinclair/typebox": "0.34.52",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.62.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
