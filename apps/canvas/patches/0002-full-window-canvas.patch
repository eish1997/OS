+<script setup lang="ts">
+import { ref } from 'vue'
+import { appPreferences, updateLocalOutputShortcut, LOCAL_OUTPUT_SHORTCUTS } from '@/app/settings/preferences/store'
+import { getLocalWorkspace } from '@/app/document/local-workspace'
+import { useEditorStore } from '@/app/editor/active-store'
+import AppButton from '@/components/ui/button/AppButton.vue'
+import AppAlert from '@/components/ui/feedback/AppAlert.vue'
+import AppInput from '@/components/ui/input/AppInput.vue'
+import LocalFilterPanel from '@/components/editor/LocalFilterPanel.vue'
+import LocalPackagePanel from '@/components/editor/LocalPackagePanel.vue'
+import { localWorkspace } from '@/theme/local-workspace'
+
+const { busy, mountBusy, mounts, refreshMounts, addMount, openMount, openSelectedFolder, currentMountId, scanBusy, scanStatus, scanFiles, error, status, documents, history, save, refresh, open, showHistory, restoreVersion } = getLocalWorkspace(useEditorStore())
+const directoryPath = ref('')
+const { preview: mountPreview, busy: mountRelinkBusy, error: mountRelinkError,
+  prepare: prepareMount, confirm: confirmMount, cancel: cancelMount } = getLocalWorkspace(useEditorStore()).mountRelink
+const { path: targetPath, preview: targetPreview, busy: targetBusy, error: targetError,
+  prepare: prepareTarget, confirm: confirmTarget, cancel: cancelTarget } = getLocalWorkspace(useEditorStore()).relink
+const { preview: replacementPreview, busy: replacementBusy, error: replacementError,
+  prepare: prepareReplacement, confirm: confirmReplacement, cancel: cancelReplacement } = getLocalWorkspace(useEditorStore()).replacement
+const { name: outputName, busy: outputBusy, error: outputError, status: outputStatus,
+  selectionStatus, publish: publishOutput, batch: outputBatch, publishBatch, retryBatch, recovery: outputRecovery, recoveryError: outputRecoveryError,
+  recoveryBusy: outputRecoveryBusy, loadRecovery: loadOutputRecovery, resume: resumeOutput,
+  cancelOperation: cancelOutput, renameOperation: renameOutput } = getLocalWorkspace(useEditorStore()).output
+const styles = localWorkspace()
+</script>
+
+<template>
+  <div :class="styles.root()" @pointerdown.stop @wheel.stop>
+    <LocalFilterPanel />
+    <LocalPackagePanel />
+    <div :class="styles.actions()">
+      <AppButton :disabled="busy" @click="save">保存到本机</AppButton>
+      <AppButton :disabled="busy" @click="refresh">本机画布</AppButton>
+      <AppButton :disabled="busy" @click="showHistory">历史版本</AppButton>
+    </div>
+    <div :class="styles.directory()">
+      <AppInput v-model="directoryPath" aria-label="本地目录路径" placeholder="输入本地文件夹路径" @enter="addMount(directoryPath)" />
+      <div :class="styles.actions()">
+        <AppButton :disabled="busy || mountBusy || !directoryPath.trim()" @click="addMount(directoryPath)">加入目录</AppButton>
+        <AppButton :disabled="busy || mountBusy" @click="refreshMounts">我的目录</AppButton>
+        <AppButton :disabled="busy || scanBusy || !currentMountId" @click="scanFiles">刷新目录</AppButton>
+        <AppButton :disabled="busy || mountBusy || !currentMountId" @click="openSelectedFolder">打开选中文件夹</AppButton>
+        <AppButton :disabled="busy || replacementBusy || !currentMountId" @click="prepareReplacement">重新关联原件</AppButton>
+        <AppButton :disabled="busy || mountRelinkBusy || !currentMountId || !directoryPath.trim()" @click="prepareMount(directoryPath)">恢复当前目录关联</AppButton>
+      </div>
+      <p v-if="scanStatus" role="status" :class="styles.status()" data-slot="directory-scan-status">{{ scanStatus }}</p>
+      <AppAlert v-if="mountPreview" tone="warning" heading="恢复目录关联"
+        :description="`原位置：${mountPreview.previousPath}；目标：${mountPreview.path}。保留当前画布和工作内容，重新扫描目标目录。同名的新文件仍需单独确认关联。`">
+        <template #actions>
+          <AppButton :disabled="mountRelinkBusy" @click="confirmMount">确认目录关联</AppButton>
+          <AppButton :disabled="mountRelinkBusy" @click="cancelMount">取消目录关联</AppButton>
+        </template>
+      </AppAlert>
+      <AppAlert v-if="mountRelinkError" tone="error" heading="目录关联" :description="mountRelinkError" />
+      <p v-if="selectionStatus" :class="styles.status()" data-slot="selected-file-status">{{ selectionStatus }}</p>
+      <AppInput v-model="outputName" :disabled="outputBusy" aria-label="成果文件名" placeholder="成果.png 或文字.txt" />
+      <AppButton :disabled="busy || scanBusy || outputBusy || !currentMountId" @click="publishOutput">保存选中成果到目录</AppButton>
+      <AppButton :disabled="busy || scanBusy || outputBusy || !currentMountId" @click="publishBatch">分别保存所选成果</AppButton>
+      <p :class="styles.status()">PNG 导出图片快照，TXT 导出文字内容；更换文件名可另存一份。批量添加 -1、-2 等序号，同名文件保留。</p>
+      <div v-if="outputBatch.length" :class="styles.list()" aria-label="批量保存结果">
+        <div v-for="item in outputBatch" :key="item.id" :class="styles.directory()" :data-state="item.state">
+          <p role="status" :class="styles.status()">{{ item.name }} · {{ item.message }}</p>
+          <AppButton v-if="item.state === 'failed' && item.operation" :disabled="outputBusy || busy || scanBusy" @click="retryBatch(item)">重试 {{ item.name }}</AppButton>
+        </div>
+      </div>
+      <p :class="styles.status()">成果快捷键：{{ appPreferences.localOutput.shortcut === 'off' ? '已关闭' : appPreferences.localOutput.shortcut.replace('Control', 'Ctrl').replace('Key', '') }}；多选时分别保存。</p>
+      <div :class="styles.actions()" aria-label="成果快捷键设置">
+        <AppButton v-for="shortcut in LOCAL_OUTPUT_SHORTCUTS" :key="shortcut"
+          :aria-pressed="appPreferences.localOutput.shortcut === shortcut"
+          :aria-label="`成果快捷键 ${shortcut === 'off' ? '关闭' : shortcut.replace('Control', 'Ctrl').replace('Key', '')}`"
+          @click="updateLocalOutputShortcut(shortcut)">
+          {{ shortcut === 'off' ? '关闭快捷键' : shortcut.replace('Control', 'Ctrl').replace('Key', '') }}
+        </AppButton>
+      </div>
+      <p v-if="outputStatus" role="status" :class="styles.status()" data-slot="output-status">{{ outputStatus }}</p>
+      <AppAlert v-if="outputError" tone="error" heading="成果落盘" :description="outputError" />
+      <AppButton :disabled="outputRecoveryBusy || outputBusy || !currentMountId" @click="loadOutputRecovery">未完成的成果</AppButton>
+      <div v-if="outputRecovery.length" :class="styles.list()" aria-label="未完成成果列表">
+        <div v-for="operation in outputRecovery" :key="operation.operationId" :class="styles.directory()">
+          <AppButton :disabled="busy || scanBusy || outputBusy" @click="resumeOutput(operation)">
+            继续保存 {{ operation.path }}（原内容版本 {{ operation.sourceRevision }}）
+          </AppButton>
+          <div :class="styles.actions()">
+            <AppButton :disabled="busy || scanBusy || outputBusy || !outputName.trim()" @click="renameOutput(operation)">按上方新文件名保存原快照</AppButton>
+            <AppButton :disabled="busy || outputBusy" @click="cancelOutput(operation)">取消保存 {{ operation.path }}</AppButton>
+          </div>
+        </div>
+      </div>
+      <AppAlert v-if="outputRecoveryError" tone="error" heading="成果恢复" :description="outputRecoveryError" />
+      <AppInput v-model="targetPath" aria-label="重新关联目标文件路径" placeholder="目标文件完整路径" @enter="prepareTarget" />
+      <AppButton :disabled="busy || targetBusy || !targetPath.trim()" @click="prepareTarget">预览其他位置的原件</AppButton>
+      <AppAlert v-if="targetPreview" tone="info" heading="关联到选定文件"
+        :description="`目标：${targetPreview.path}（${targetPreview.size} 字节）。仅改变选中节点的文件引用，可撤销；确认后目标所在目录会登记用于持续同步。`">
+        <template #actions>
+          <AppButton :disabled="targetBusy" @click="confirmTarget">确认更改节点引用</AppButton>
+          <AppButton :disabled="targetBusy" @click="cancelTarget">取消更改引用</AppButton>
+        </template>
+      </AppAlert>
+      <AppAlert v-if="targetError" tone="error" heading="目标文件" :description="targetError" />
+      <AppAlert v-if="replacementPreview" tone="warning" heading="确认新原件"
+        :description="`将此资产关联到 ${replacementPreview.path}（${replacementPreview.size} 字节）。引用它的节点会更新，画布位置和工作内容保留。文件夹确认会保留已登记子画布；其中同名新文件仍需分别确认。`">
+        <template #actions>
+          <AppButton :disabled="replacementBusy" @click="confirmReplacement">确认关联新原件</AppButton>
+          <AppButton :disabled="replacementBusy" @click="cancelReplacement">取消关联</AppButton>
+        </template>
+      </AppAlert>
+      <AppAlert v-if="replacementError" tone="error" heading="文件关联" :description="replacementError" />
+      <div v-if="mounts.length" :class="styles.list()" aria-label="本地目录列表">
+        <AppButton v-for="mount in mounts" :key="mount.id" :disabled="busy || mountBusy" :title="mount.path" :aria-label="mount.path" @click="openMount(mount)">
+          {{ mount.path.split(/[\\/]/).filter(Boolean).at(-1) ?? mount.path }}{{ mount.availability === 'available' ? '' : ' · 不可用' }}
+        </AppButton>
+      </div>
+    </div>
+    <div v-if="history.length" :class="styles.list()" aria-label="历史版本列表">
+      <AppButton v-for="version in history" :key="version.revision" :disabled="busy" @click="restoreVersion(version)">
+        恢复版本 {{ version.revision }}
+      </AppButton>
+    </div>
+    <p role="status" :class="styles.status()" data-slot="local-save-status">{{ status }}</p>
+    <AppAlert v-if="error" tone="error" heading="本机画布" :description="error" />
+    <div v-if="documents.length" :class="styles.list()" aria-label="本机画布列表">
+      <AppButton v-for="document in documents" :key="document.canvasId" :disabled="busy" @click="open(document)">
+        {{ document.metadata.name }} · {{ document.revision }}
+      </AppButton>
+    </div>
+  </div>
+</template>
