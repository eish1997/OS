--- /dev/null
+++ b/src/app/document/local-connection-visibility.ts
@@ -0,0 +1,26 @@
+import type { SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+import { getWorldMatrix } from '@open-pencil/scene-graph/coordinate'
+import Matrix from '@open-pencil/scene-graph/matrix'
+
+/** Test each ancestor clip in its own coordinates, including rotated frames. */
+export function anchorUnclipped(graph: SceneGraph, node: SceneNode, x: number, y: number) {
+  let parent = graph.getNode(node.parentId ?? '')
+  while (parent) {
+    if (parent.clipsContent) {
+      const inverse = Matrix.invert(getWorldMatrix(parent, graph))
+      if (!inverse) return false
+      const [px, py] = Matrix.mapPoints(inverse, [x, y])
+      if (px < -0.00001 || py < -0.00001 || px > parent.width + 0.00001 || py > parent.height + 0.00001) return false
+    }
+    parent = graph.getNode(parent.parentId ?? '')
+  }
+  return true
+}
+
+/** Pointer capture must not make a panel-covered anchor eligible for a drop. */
+export function anchorUncovered(layer: HTMLElement, x: number, y: number) {
+  const area = layer.closest('[data-test-id="canvas-area"]')
+  const canvas = area?.querySelector('[data-test-id="canvas-element"]')
+  const top = document.elementsFromPoint(x, y).find(element => !layer.contains(element))
+  return canvas !== null && top === canvas
+}
