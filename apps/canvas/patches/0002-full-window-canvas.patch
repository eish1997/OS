@@ -0,0 +1,56 @@
+import { workspaceFetch } from '@/app/document/workspace-fetch'
+import { ref } from 'vue'
+import * as v from 'valibot'
+import type { Editor } from '@open-pencil/core/editor'
+
+const previewSchema = v.object({ token: v.string(), mountId: v.string(), canvasId: v.string(), previousPath: v.string(), path: v.string() })
+
+export function createLocalMountRelink(editor: Editor, mountId: () => string, refresh: () => Promise<void>) {
+  const preview = ref<v.InferOutput<typeof previewSchema>>()
+  const busy = ref(false)
+  const error = ref('')
+  let generation = 0
+  let disposed = false
+  const isCurrent = (value: number, id: string) => !disposed && generation === value && mountId() === id
+  function cancel() { generation++; preview.value = undefined; error.value = '' }
+  const stopGraph = editor.onEditorEvent('graph:replaced', cancel)
+  async function call(id: string, action: string, body: { path: string } | { token: string }) {
+    const response = await workspaceFetch(`/os-workspace/mounts/${id}/relink-${action}`, { method: 'POST',
+      headers: { 'X-OS-Workspace': '1', 'Content-Type': 'application/json' },
+      body: JSON.stringify(body), signal: AbortSignal.timeout(30000) })
+    if (!response.ok) throw new Error(response.status === 409
+      ? '目录已变化或已关联另一张画布，请重新检查；不会自动合并画布。'
+      : '无法访问目标目录，请检查完整路径。')
+    return response
+  }
+  async function prepare(path: string) {
+    if (busy.value) return
+    cancel()
+    const id = mountId(), current = generation
+    if (!id || !path.trim()) { error.value = '请打开原目录画布，并填写目标目录完整路径。'; return }
+    busy.value = true
+    try {
+      const response = await call(id, 'preview', { path: path.trim() })
+      const result = v.parse(v.pipe(v.string(), v.parseJson(), previewSchema), await response.text())
+      if (isCurrent(current, id)) preview.value = result
+    } catch (cause) {
+      if (isCurrent(current, id)) error.value = cause instanceof Error ? cause.message : '无法预览目录'
+    } finally { busy.value = false }
+  }
+  async function confirm() {
+    const candidate = preview.value
+    if (!candidate || busy.value) return
+    const current = generation
+    busy.value = true; error.value = ''
+    try {
+      await call(candidate.mountId, 'confirm', { token: candidate.token })
+      if (!isCurrent(current, candidate.mountId)) return
+      preview.value = undefined
+      await refresh()
+    } catch (cause) {
+      if (isCurrent(current, candidate.mountId)) error.value = cause instanceof Error ? cause.message : '无法恢复目录关联'
+    } finally { busy.value = false }
+  }
+  function dispose() { disposed = true; cancel(); stopGraph() }
+  return { preview, busy, error, prepare, confirm, cancel, dispose }
+}
diff --git a/src/app/document/local-output.ts b/src/app/document/local-output.ts
new file mode 100644
index 0000000..38ad84e
--- /dev/null
+++ b/src/app/document/local-output.ts
@@ -0,0 +1,315 @@
+import { workspaceFetch } from '@/app/document/workspace-fetch'
+import { ref } from 'vue'
+import { fromUint8Array } from 'js-base64'
+import * as v from 'valibot'
+import type { Editor } from '@open-pencil/core/editor'
+import { localNodeId } from '@/app/document/local-identity'
+import { fileLinks, selectedFileNode } from '@/app/document/local-file-nodes'
+
+type Context = { canvasId: string; mountId: string; revision: number; version: number }
+type OutputEditor = Editor & { renderExportImage(ids: string[], scale: number, format: 'PNG'): Promise<Uint8Array | null> }
+type Pending = { operationId: string; canvasId: string; nodeId: string; sourceRevision: number;
+  mountId: string; name: string; contentBase64: string }
+const operationSchema = v.object({ operationId: v.string(), canvasId: v.string(), nodeId: v.string(),
+  mountId: v.string(), path: v.string(), sourceRevision: v.number(),
+  state: v.picklist(['prepared', 'ready', 'committed']) })
+type Operation = v.InferOutput<typeof operationSchema>
+type BatchItem = { id: string; nodeId: string; name: string; state: 'queued' | 'ready' | 'writing' | 'saved' | 'failed';
+  message: string; operation?: Pending }
+type Replacement = { replacementId: string; name: string }
+class OutputRequestError extends Error {
+  constructor(readonly statusCode: number, message: string) {
+    super(message)
+    this.name = 'OutputRequestError'
+  }
+}
+
+export function createLocalOutput(editor: OutputEditor, context: () => Context,
+  save: () => Promise<boolean>, refresh: () => Promise<void>, onIdle: () => void) {
+  const name = ref('成果.png'), busy = ref(false), error = ref(''), status = ref('')
+  const batch = ref<BatchItem[]>([])
+  let pending: Pending | undefined
+  const replacements = new Map<string, Replacement>()
+  function clearCompleted(operationId: string) {
+    if (pending?.operationId === operationId) pending = undefined
+  }
+  let disposed = false
+  const isDisposed = () => disposed
+  function release() { busy.value = false; if (!isDisposed()) onIdle() }
+  const selectionStatus = ref('')
+  let comparisonGeneration = 0
+  let comparisonTimer: ReturnType<typeof setTimeout> | undefined
+  const recovery = ref<Operation[]>([]), recoveryError = ref(''), recoveryBusy = ref(false)
+  let recoveryGeneration = 0
+  const isCurrent = (id: string) => !isDisposed() && context().canvasId === id
+  async function loadRecovery() {
+    const generation = ++recoveryGeneration, target = context()
+    recovery.value = []; recoveryError.value = ''
+    if (!target.mountId || isDisposed()) return
+    recoveryBusy.value = true
+    try {
+      const response = await workspaceFetch(`/os-workspace/canvases/${target.canvasId}/outputs`, {
+        headers: { 'X-OS-Workspace': '1' }, signal: AbortSignal.timeout(30000) })
+      if (!response.ok) throw new Error('无法读取未完成成果，请重试。')
+      const rows = v.parse(v.pipe(v.string(), v.parseJson(), v.array(operationSchema)), await response.text())
+      if (generation === recoveryGeneration && isCurrent(target.canvasId)) {
+        recovery.value = rows.filter(row => row.canvasId === target.canvasId && row.state !== 'committed')
+      }
+    } catch (cause) {
+      if (generation === recoveryGeneration && isCurrent(target.canvasId)) {
+        recoveryError.value = cause instanceof Error ? cause.message : '无法读取未完成成果'
+      }
+    } finally { if (generation === recoveryGeneration) recoveryBusy.value = false }
+  }
+  function updateSelectionStatus() {
+    const generation = ++comparisonGeneration
+    clearTimeout(comparisonTimer)
+    const node = selectedFileNode(editor)
+    const links = node ? fileLinks(node) : []
+    const labels = links.map(link => {
+      const state = { available: '已关联本地', missing: '原件缺失', replaced: '需要重新关联' }[link.availability]
+      return `${state} · ${link.path}`
+    })
+    selectionStatus.value = labels.join('；')
+    if (!node || !links.some(link => link.outputOrigin)) return
+    const graph = editor.graph
+    const compare = async () => {
+      const results = await compareSnapshots(node.id, links)
+      if (isDisposed() || comparisonGeneration !== generation || editor.graph !== graph) return
+      selectionStatus.value = labels.map((label, index) => `${label}${results[index]}`).join('；')
+    }
+    comparisonTimer = setTimeout(() => { void compare() }, 250)
+  }
+  async function compareSnapshots(id: string, links: ReturnType<typeof fileLinks>) {
+    const hashes = new Map<string, Promise<string | undefined>>()
+    const node = editor.graph.getNode(id)
+    return Promise.all(links.map(async link => {
+      const origin = link.outputOrigin
+      if (!origin || !node || origin.nodeId !== localNodeId(node) || origin.canvasId !== context().canvasId) return ''
+      if (!origin.snapshotHash || !origin.snapshotFormat || origin.snapshotFormat === 'unknown') return ' · 尚未核对导出内容'
+      let digest = hashes.get(origin.snapshotFormat)
+      if (!digest) {
+        digest = snapshotDigest(id, origin.snapshotFormat)
+        hashes.set(origin.snapshotFormat, digest)
+      }
+      const current = await digest
+      if (!current) return ' · 尚未核对导出内容'
+      return current === origin.snapshotHash ? ' · 与导出快照一致' : ' · 内容已修改，尚未重新导出'
+    }))
+  }
+  async function snapshotDigest(id: string, format: 'png' | 'txt') {
+    try {
+      const node = editor.graph.getNode(id)
+      if (!node || (format === 'txt' && node.type !== 'TEXT')) return undefined
+      const bytes = format === 'txt' ? new TextEncoder().encode(node.text) : await editor.renderExportImage([id], 1, 'PNG')
+      if (!bytes) return undefined
+      const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', new Uint8Array(bytes)))
+      return [...digest].map(byte => byte.toString(16).padStart(2, '0')).join('')
+    } catch { return undefined }
+  }
+  const stops = (['selection:changed', 'graph:replaced', 'node:updated', 'node:deleted',
+    'node:created', 'node:reparented', 'node:reordered', 'history:changed'] as const).map(
+    event => editor.onEditorEvent(event, updateSelectionStatus))
+  stops.push(editor.onEditorEvent('graph:replaced', () => {
+    recoveryGeneration++; recovery.value = []; recoveryError.value = ''; recoveryBusy.value = false
+    pending = undefined; batch.value = []; error.value = ''; status.value = ''
+  }))
+  async function call(path: string, body?: Pending | Replacement) {
+    const response = await workspaceFetch(`/os-workspace${path}`, { method: 'POST',
+      headers: { 'X-OS-Workspace': '1', 'Content-Type': 'application/json' },
+      body: body ? JSON.stringify(body) : undefined, signal: AbortSignal.timeout(30000) })
+    if (response.status === 409 && path === '/outputs') pending = undefined
+    if (response.status === 400) throw new OutputRequestError(400, '请检查文件名；更名时需保持原扩展名。')
+    if (response.status === 501) throw new OutputRequestError(501, '当前目录不支持安全提交文件。原快照已保留，可在未完成的成果中取消本次保存。')
+    if (!response.ok) throw new OutputRequestError(response.status, response.status === 409
+      ? '文件名已存在或目录、文件发生变化。原文件未被覆盖，请检查后重试。'
+      : '成果写入未确认，工作内容仍保留；重试会继续同一操作。')
+    return response
+  }
+  function captureSelection() {
+    const ids = [...editor.state.selectedIds]
+    if (ids.length !== 1) throw new Error('请选中一个成果，或使用分别保存。')
+    return capture({ id: ids[0], name: name.value.trim() })
+  }
+  async function capture(target: { id: string; name: string }): Promise<Pending> {
+    if (!context().mountId) throw new Error('请打开目录画布并选中成果。')
+    const graph = editor.graph, id = target.id, node = graph.getNode(id)
+    if (!node || node.type === 'CANVAS') throw new Error('请选择可导出的内容节点。')
+    const fileName = target.name
+    if (!/\.(png|txt)$/i.test(fileName)) throw new Error('当前支持 .png 图片快照，文字节点也可保存为 .txt。')
+    if (/\.txt$/i.test(fileName) && node.type !== 'TEXT') throw new Error('只有文字节点可以保存为 .txt。')
+    if (!await save()) throw new Error('请先完成画布保存，再保存成果。')
+    if (isDisposed() || editor.graph !== graph || !graph.getNode(id)) throw new Error('画布已切换，请重新选择成果。')
+    const source = context(), nodeId = localNodeId(node)
+    if (!nodeId) throw new Error('节点身份尚未保存。')
+    const bytes = /\.txt$/i.test(fileName) ? new TextEncoder().encode(node.text)
+      : await editor.renderExportImage([id], 1, 'PNG')
+    const current = context()
+    if (isDisposed() || editor.graph !== graph || current.canvasId !== source.canvasId || current.version !== source.version) {
+      throw new Error('导出期间内容有变化，请重新保存成果。')
+    }
+    if (!bytes) throw new Error('无法生成此节点的图片快照。')
+    return { operationId: crypto.randomUUID(), canvasId: source.canvasId, nodeId,
+      sourceRevision: source.revision, mountId: source.mountId, name: fileName, contentBase64: fromUint8Array(bytes) }
+  }
+  async function writeBatchItem(item: BatchItem) {
+    const operation = item.operation
+    if (!operation || !isCurrent(operation.canvasId)) return
+    item.state = 'writing'; item.message = '正在写入'
+    try {
+      await call('/outputs', operation)
+      if (!isCurrent(operation.canvasId)) return
+      await call(`/outputs/${operation.operationId}/commit`)
+      if (!isCurrent(operation.canvasId)) return
+      item.state = 'saved'; item.message = '文件已写入'
+    } catch (cause) {
+      item.state = 'failed'
+      item.message = cause instanceof Error ? cause.message : '保存未确认，请重试同一项'
+    }
+  }
+  async function finishBatch(targetId: string) {
+    if (!isCurrent(targetId)) return
+    await refresh()
+    if (!isCurrent(targetId)) return
+    const saved = await save()
+    if (!isCurrent(targetId)) return
+    for (const item of batch.value) {
+      if (item.state !== 'saved') continue
+      const linked = [...editor.graph.nodes.values()].some(node => fileLinks(node).some(
+        link => link.outputOrigin?.operationId === item.operation?.operationId))
+      item.message = saved && linked ? '文件与画布已保存' : '文件已写入，画布关联待保存'
+    }
+    const count = batch.value.filter(item => item.state === 'saved').length
+    status.value = `批量处理结束：${count} 项已写入，${batch.value.length - count} 项未完成`
+    await loadRecovery()
+  }
+  async function publishBatch() {
+    if (busy.value || isDisposed()) return
+    if (pending) { error.value = '请先重试或处理上一项未确认成果，再开始批量保存。'; return }
+    const ids = [...editor.state.selectedIds], fileName = name.value.trim()
+    const extension = /\.(png|txt)$/i.exec(fileName)
+    if (!context().mountId || !ids.length || !extension) {
+      error.value = '请打开目录画布，选择成果，并输入 .png 或 .txt 文件名。'; return
+    }
+    busy.value = true; error.value = ''; status.value = '正在准备批量成果'
+    const targetId = context().canvasId
+    const stem = fileName.slice(0, -extension[0].length)
+    batch.value = ids.map((nodeId, index) => ({ id: crypto.randomUUID(), nodeId,
+      name: `${stem}-${index + 1}${extension[0]}`, state: 'queued', message: '等待准备' }))
+    const items = batch.value
+    try {
+      // Capture every selected node before publishing any file. Each captured
+      // request retains its own saved source revision and bytes for exact retries.
+      for (const item of items) {
+        if (!isCurrent(targetId)) return
+        try {
+          item.operation = await capture({ id: item.nodeId, name: item.name })
+          item.state = 'ready'; item.message = '已准备'
+        } catch (cause) {
+          item.state = 'failed'; item.message = cause instanceof Error ? cause.message : '无法准备成果'
+        }
+      }
+      for (const item of items) {
+        if (!isCurrent(targetId)) return
+        if (item.state === 'ready') await writeBatchItem(item)
+      }
+      await finishBatch(targetId)
+    } catch (cause) {
+      if (isCurrent(targetId)) error.value = cause instanceof Error ? cause.message : '批量关联尚待保存'
+    } finally { release() }
+  }
+  async function retryBatch(item: BatchItem) {
+    if (busy.value || !item.operation || !isCurrent(item.operation.canvasId)) return
+    busy.value = true; error.value = ''
+    const targetId = item.operation.canvasId
+    try {
+      await writeBatchItem(item)
+      await finishBatch(targetId)
+    } catch (cause) {
+      if (isCurrent(targetId)) error.value = cause instanceof Error ? cause.message : '批量关联尚待保存'
+    } finally { release() }
+  }
+  async function publishSelection() {
+    if (!pending && editor.state.selectedIds.size > 1) await publishBatch()
+    else await publish()
+  }
+  async function publish() {
+    if (busy.value || isDisposed()) return
+    busy.value = true; error.value = ''; status.value = '正在保存成果'
+    const targetId = context().canvasId
+    try {
+      const operation = pending ?? await captureSelection()
+      if (!isCurrent(operation.canvasId)) return
+      pending = operation
+      await call('/outputs', operation)
+      await call(`/outputs/${operation.operationId}/commit`)
+      clearCompleted(operation.operationId)
+      await finish(operation)
+    } catch (cause) {
+      if (isCurrent(targetId)) {
+        error.value = cause instanceof Error ? cause.message : '无法保存成果'
+        status.value = '成果保存未完成'
+      }
+    } finally { release() }
+  }
+  async function finish(operation: { operationId: string; canvasId: string }) {
+    if (!isCurrent(operation.canvasId)) return
+    await refresh()
+    if (!isCurrent(operation.canvasId)) return
+    const saved = await save()
+    if (!isCurrent(operation.canvasId)) return
+    const linked = [...editor.graph.nodes.values()].some(node => fileLinks(node).some(link => link.outputOrigin?.operationId === operation.operationId))
+    status.value = saved && linked ? '成果已写入目录，画布已保存' : '文件已写入目录；画布关联尚待保存'
+    await loadRecovery()
+  }
+  async function resume(operation: Operation) {
+    if (busy.value || !isCurrent(operation.canvasId)) return
+    busy.value = true; error.value = ''; status.value = '正在继续保存原成果'
+    try {
+      await call(`/outputs/${operation.operationId}/commit`)
+      clearCompleted(operation.operationId)
+      await finish(operation)
+    } catch (cause) {
+      if (isCurrent(operation.canvasId)) {
+        error.value = cause instanceof Error ? cause.message : '无法继续保存成果'
+        status.value = '原成果仍待恢复，可重试'
+      }
+    } finally { release() }
+  }
+  async function cancelOperation(operation: Operation) {
+    if (busy.value || !isCurrent(operation.canvasId)) return
+    busy.value = true; error.value = ''
+    try {
+      await call(`/outputs/${operation.operationId}/cancel`)
+      clearCompleted(operation.operationId)
+      if (!isCurrent(operation.canvasId)) return
+      await loadRecovery()
+      if (isCurrent(operation.canvasId)) status.value = '已取消后续提交，画布内容和现有文件保留'
+    } catch {
+      if (isCurrent(operation.canvasId)) error.value = '未能取消。文件可能已写出，请继续恢复；取消不会删除文件。'
+    } finally { release() }
+  }
+  async function renameOperation(operation: Operation) {
+    if (busy.value || !isCurrent(operation.canvasId)) return
+    const replacement = replacements.get(operation.operationId) ?? { replacementId: crypto.randomUUID(), name: name.value.trim() }
+    replacements.set(operation.operationId, replacement)
+    busy.value = true; error.value = ''; status.value = `正在保存原快照为 ${replacement.name}`
+    try {
+      const response = await call(`/outputs/${operation.operationId}/replace`, replacement)
+      const result = v.parse(v.pipe(v.string(), v.parseJson(), operationSchema), await response.text())
+      clearCompleted(operation.operationId)
+      await call(`/outputs/${result.operationId}/commit`)
+      replacements.delete(operation.operationId)
+      await finish(result)
+    } catch (cause) {
+      if (cause instanceof OutputRequestError && [400, 409].includes(cause.statusCode)) replacements.delete(operation.operationId)
+      if (isCurrent(operation.canvasId)) {
+        error.value = cause instanceof Error ? cause.message : '无法更名保存原成果'
+        status.value = `更名保存未完成：${replacement.name}`
+        await loadRecovery()
+      }
+    } finally { release() }
+  }
+  return { name, busy, error, status, selectionStatus, publish, publishSelection, batch, publishBatch, retryBatch, recovery, recoveryError, recoveryBusy, loadRecovery, resume, cancelOperation, renameOperation,
+    dispose: () => { disposed = true; comparisonGeneration++; clearTimeout(comparisonTimer); for (const stop of stops) stop() } }
+}
diff --git a/src/app/document/local-packages.ts b/src/app/document/local-packages.ts
new file mode 100644
index 0000000..8e264f4
--- /dev/null
+++ b/src/app/document/local-packages.ts
@@ -0,0 +1,111 @@
+import { workspaceFetch } from '@/app/document/workspace-fetch'
+import { ref } from 'vue'
+import * as v from 'valibot'
+import { downloadBlob, readBoundedBody } from '@/app/document/io/browser'
+import { useLocalLayout } from '@/app/shell/local-layout'
+
+const limit = 350 * 1024 * 1024
+const resultSchema = v.object({ operationId: v.string(), canvasId: v.string(), revision: v.number(),
+  layoutApplied: v.boolean(), layout: v.unknown() })
+const operationSchema = v.object({ operationId: v.string(), canvasId: v.string(),
+  state: v.picklist(['prepared', 'complete']), result: v.nullable(resultSchema) })
+type Context = { canvasId: string; revision: number; generation: number }
+
+export function createLocalPackages(context: () => Context, save: () => Promise<boolean>,
+  refreshDocuments: () => Promise<void>, unavailable: () => boolean) {
+  const busy = ref(false), error = ref(''), status = ref('')
+  const operations = ref<v.InferOutput<typeof operationSchema>[]>([])
+  const upload = ref<{ operationId: string; file: File }>()
+  const shellLayout = useLocalLayout()
+  let disposed = false
+  let controller = new AbortController()
+  const active = () => !disposed
+  async function request(path: string, init?: RequestInit) {
+    const headers = new Headers(init?.headers)
+    headers.set('X-OS-Workspace', '1')
+    const response = await workspaceFetch(`/os-workspace${path}`, { ...init,
+      headers, signal: controller.signal })
+    const messages: Record<number, string> = {
+      409: '作品或目录已存在，或保存版本已变化。请保留现有内容，检查后再重试。',
+      413: '作品包超过 350 MiB。',
+      422: '作品包损坏或格式不受支持，原有画布保持不变。'
+    }
+    if (!response.ok) throw new Error(messages[response.status]
+      ?? '作品包操作未完成。请重试；已准备的导入可从导入记录继续。')
+    return response
+  }
+  async function run(action: () => Promise<void>) {
+    if (busy.value || unavailable() || disposed) return
+    busy.value = true; error.value = ''
+    controller = new AbortController()
+    const timeout = setTimeout(() => controller.abort(), 60000)
+    try { await action() }
+    catch (cause) {
+      if (active()) error.value = controller.signal.aborted
+        ? '操作等待超时，可重试。已准备的导入仍保留在导入记录中。'
+        : (cause instanceof Error ? cause.message : '作品包操作失败')
+    }
+    finally { clearTimeout(timeout); busy.value = false }
+  }
+  async function load() {
+    const response = await request('/package-imports')
+    const rows = v.parse(v.pipe(v.string(), v.parseJson(), v.array(operationSchema)), await response.text())
+    if (active()) operations.value = rows
+  }
+  async function resumeOperation(operationId: string) {
+    const response = await request(`/package-imports/${operationId}/resume`, { method: 'POST' })
+    const result = v.parse(v.pipe(v.string(), v.parseJson(), resultSchema), await response.text())
+    if (!active()) return
+    if (result.layoutApplied && !shellLayout.busy.value && !shellLayout.error.value) await shellLayout.reload()
+    if (!active()) return
+    status.value = '作品已导入，可从本机画布列表打开。外部原件需核对关联。'
+      + (result.layoutApplied ? '包内布局已恢复到本机。' : '当前布局已保留，包内布局另存为预设。')
+    if (upload.value?.operationId === operationId) upload.value = undefined
+    await refreshDocuments()
+    await load()
+  }
+  async function retryUpload() {
+    await run(async () => {
+      const pending = upload.value
+      if (!pending) return
+      status.value = `正在导入 ${pending.file.name}`
+      await request(`/package-imports/${pending.operationId}`, { method: 'POST',
+        headers: { 'Content-Type': 'application/octet-stream' }, body: pending.file })
+      if (active()) await resumeOperation(pending.operationId)
+    })
+  }
+  async function importFile(file: File) {
+    if (busy.value || unavailable() || disposed) return
+    if (upload.value) { error.value = '请先重试当前作品包，避免遗失未确认的导入操作。'; return }
+    if (!file.size || file.size > limit) { error.value = '请选择不超过 350 MiB 的有效作品包。'; return }
+    upload.value = { operationId: crypto.randomUUID(), file }
+    await retryUpload()
+  }
+  async function exportCurrent() {
+    await run(async () => {
+      const before = context()
+      status.value = '正在保存并打包作品'
+      if (!await save()) throw new Error('请先完成当前画布保存，再导出作品包。')
+      const saved = context()
+      if (!active() || saved.canvasId !== before.canvasId || saved.generation !== before.generation) return
+      const response = await request(`/canvases/${saved.canvasId}/package`, { method: 'POST',
+        headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ expectedRevision: saved.revision }) })
+      const bytes = await readBoundedBody(response, limit)
+      if (!active()) return
+      downloadBlob(bytes, `${saved.canvasId}.oscanvas`, 'application/octet-stream')
+      status.value = '作品包已下载，包含历史与文件关联；不包含外部原件。'
+    })
+  }
+  return { busy, error, status, operations, upload, importFile, retryUpload, exportCurrent,
+    applyLayout: (value: unknown) => run(async () => {
+      if (!await shellLayout.applyPreset(value)) throw new Error(shellLayout.error.value || '布局正在保存或已有新修改，请稍后再应用。')
+      if (active()) status.value = '已应用包内布局；画布内容与历史保持不变。'
+    }),
+    forgetUpload: () => {
+      if (busy.value) return
+      upload.value = undefined; error.value = ''
+      status.value = '可选择另一个作品包。已准备的操作仍保留在导入记录中。'
+    },
+    refresh: () => run(load), resume: (id: string) => run(() => resumeOperation(id)),
+    dispose: () => { disposed = true; controller.abort(); upload.value = undefined } }
+}
