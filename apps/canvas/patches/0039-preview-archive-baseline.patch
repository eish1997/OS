diff --git a/packages/core/tests/io/formats/fig/session/preview-baseline.test.ts b/packages/core/tests/io/formats/fig/session/preview-baseline.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/tests/io/formats/fig/session/preview-baseline.test.ts
@@ -0,0 +1,21 @@
+import { expect, test } from 'bun:test'
+import { exportFigFile, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+import { archiveBaseline, archiveChanges } from '#core/kiwi/fig/session/archive-changes'
+
+test('preview captures archive state before mutation without marking a canceled edit dirty', async () => {
+  await initCodec()
+  const original = new SceneGraph()
+  original.createNode('FRAME', original.getPages()[0].id, { name: 'Grid', layoutMode: 'GRID' })
+  const graph = await parseFigFile((await exportFigFile(original)).slice().buffer as ArrayBuffer)
+  const node = [...graph.nodes.values()].find(n => n.name === 'Grid')
+  if (!node) throw new Error('Grid missing')
+  graph.updateNodePreview(node.id, { layoutMode: 'HORIZONTAL' })
+  expect(archiveBaseline(graph)?.before.get(node.id)?.layoutMode).toBe('GRID')
+  graph.updateNodePreview(node.id, { layoutMode: 'GRID' })
+  expect(archiveChanges(graph)?.touched.size).toBe(0)
+  graph.updateNodePreview(node.id, { layoutMode: 'HORIZONTAL' })
+  graph.updateNode(node.id, { layoutMode: 'HORIZONTAL' })
+  expect(archiveBaseline(graph)?.before.get(node.id)?.layoutMode).toBe('GRID')
+  const restored = await parseFigFile((await exportFigFile(graph)).slice().buffer as ArrayBuffer)
+  expect([...restored.nodes.values()].find(n => n.name === 'Grid')?.layoutMode).toBe('HORIZONTAL')
+})
