+import { expect, test } from 'bun:test'
+import { createEditor } from '@open-pencil/core/editor'
+import { resolveObjectPixelSnap } from '#vue/shared/input/snap'
+
+test('filtered targets do not attract object snapping, while explicit canvas guides remain usable', () => {
+  const editor = createEditor(), graph = editor.graph
+  editor.state.snappingPreferences = { objects: true, geometry: false, pixelGrid: false }
+  const frame = graph.createNode('FRAME', editor.state.currentPageId)
+  const target = graph.createNode('RECTANGLE', frame.id, { x: 100, y: 100, width: 40, height: 40 })
+  const bounds = { x: 98, y: 20, width: 10, height: 10 }
+  const snap = () => resolveObjectPixelSnap(new Set(), bounds, [target], editor)
+  expect(snap().correction.x).toBe(2)
+  graph.setViewHiddenNodes(new Set([frame.id]))
+  expect(snap().correction).toEqual({ x: 0, y: 0 })
