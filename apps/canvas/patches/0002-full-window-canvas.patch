+<script setup lang="ts">
+import { getLocalWorkspace } from '@/app/document/local-workspace'
+import { useEditorStore } from '@/app/editor/active-store'
+import type { LocalContentType, LocalAssociation } from '@/app/document/local-filter'
+import AppButton from '@/components/ui/button/AppButton.vue'
+import AppInput from '@/components/ui/input/AppInput.vue'
+import { localWorkspace } from '@/theme/local-workspace'
+
+const { criteria, projection, toggleType, toggleAssociation, clear, showMatches } = getLocalWorkspace(useEditorStore()).filter
+const types: { value: LocalContentType; label: string }[] = [
+  { value: 'image', label: '图片' }, { value: 'video', label: '视频' }, { value: 'audio', label: '音频' },
+  { value: 'model', label: '3D' }, { value: 'text', label: '文本' }, { value: 'document', label: '文档' },
+  { value: 'webpage', label: '网页' }, { value: 'folder', label: '文件夹' }, { value: 'shape', label: '图形' },
+  { value: 'line', label: '线条' }, { value: 'group', label: '分组/画框' }, { value: 'file', label: '其它文件' }
+]
+const associations: { value: LocalAssociation; label: string }[] = [
+  { value: 'local', label: '已关联本地' }, { value: 'canvas', label: '仅画布内容' }, { value: 'unavailable', label: '关联失效' }
+]
+const styles = localWorkspace()
+</script>
+
+<template>
+  <details :class="styles.directory()" data-slot="local-filter-panel">
+    <summary :class="styles.status()">筛选 · {{ projection.shown.size }}/{{ projection.total }}</summary>
+    <AppInput v-model="criteria.query" aria-label="筛选名称或文件名" placeholder="搜索名称或文件名" />
+    <div :class="styles.actions()" aria-label="文件关联筛选">
+      <AppButton v-for="option in associations" :key="option.value" :aria-pressed="criteria.associations.includes(option.value)"
+        :variant="criteria.associations.includes(option.value) ? 'subtle' : 'ghost'"
+        :aria-label="`筛选${option.label}`" @click="toggleAssociation(option.value)">{{ option.label }}</AppButton>
+    </div>
+    <div :class="styles.actions()" aria-label="内容类型筛选">
+      <AppButton v-for="option in types" :key="option.value" :aria-pressed="criteria.types.includes(option.value)"
+        :variant="criteria.types.includes(option.value) ? 'subtle' : 'ghost'"
+        :aria-label="`筛选${option.label}`" @click="toggleType(option.value)">{{ option.label }}</AppButton>
+    </div>
+    <p :class="styles.status()" data-slot="local-filter-count">显示 {{ projection.shown.size }} 项 · 隐藏 {{ projection.hidden.size }} 项</p>
+    <p :class="styles.status()">组内有内容匹配时保留整组；筛选不会修改或删除内容。</p>
+    <AppButton @click="clear">清除筛选</AppButton>
+    <AppButton :disabled="projection.shown.size === 0" @click="showMatches">查看匹配内容</AppButton>
+  </details>
+</template>
diff --git a/src/components/editor/LocalPackagePanel.vue b/src/components/editor/LocalPackagePanel.vue
