--- /dev/null
+++ b/src/app/document/local-filter-session.ts
@@ -0,0 +1,34 @@
+import { computed, ref, watch } from 'vue'
+import type { Editor } from '@open-pencil/core/editor'
+import { localFilterProjection, type LocalFilter, type LocalContentType, type LocalAssociation } from '@/app/document/local-filter'
+
+export function createLocalFilter(editor: Editor) {
+  const criteria = ref<LocalFilter>({ types: [], associations: [], query: '' })
+  const revision = ref(0)
+  const projection = computed(() => {
+    void editor.state.sceneVersion
+    return localFilterProjection(editor.graph, editor.state.currentPageId, criteria.value)
+  })
+  const stop = watch(projection, value => {
+    if (!editor.graph.setViewHiddenNodes(value.hidden)) return
+    revision.value++
+    editor.select([...editor.state.selectedIds])
+    if (editor.state.hoveredNodeId && editor.graph.isViewHidden(editor.state.hoveredNodeId)) editor.setHoveredNode(null)
+    editor.validateEnteredContainer()
+    editor.requestRender()
+  }, { immediate: true, flush: 'sync' })
+  function toggleType(value: LocalContentType) {
+    const values = criteria.value.types
+    criteria.value = { ...criteria.value, types: values.includes(value) ? values.filter(item => item !== value) : [...values, value] }
+  }
+  function toggleAssociation(value: LocalAssociation) {
+    const values = criteria.value.associations
+    criteria.value = { ...criteria.value, associations: values.includes(value) ? values.filter(item => item !== value) : [...values, value] }
+  }
+  function clear() { criteria.value = { types: [], associations: [], query: '' } }
+  function showMatches() {
+    editor.revealNodes([...projection.value.shown].filter(id => editor.graph.getNode(id)?.visible))
+  }
+  return { criteria, projection, revision, toggleType, toggleAssociation, clear, showMatches,
+    dispose() { stop(); editor.graph.setViewHiddenNodes(new Set()) } }
+}
