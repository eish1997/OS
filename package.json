{
  "name": "personal-ai-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "probe:pi": "tsx scripts/probe-pi.ts",
    "test:workbench-ui": "vite build --outDir output/workbench-build && tsx scripts/workbench-ui-qa.ts && tsx scripts/workbench-layout-qa.ts && tsx scripts/workbench-appearance-qa.ts",
    "backup": "tsx scripts/backup.ts",
    "node": "tsx scripts/local-node.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@sinclair/typebox": "0.34.52",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.62.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
