@@ -0,0 +1,52 @@
+import { computed } from 'vue'
+import type { Editor } from '@open-pencil/core/editor'
+import type { ViewportTransform } from '@open-pencil/core/geometry'
+import type { SceneNode } from '@open-pencil/scene-graph'
+import { getWorldMatrix } from '@open-pencil/scene-graph/coordinate'
+import Matrix from '@open-pencil/scene-graph/matrix'
+import { fileLinks } from '@/app/document/local-file-nodes'
+import { localNodeId } from '@/app/document/local-identity'
+
+function visibleAnchor(editor: Editor, node: SceneNode) {
+  const at = editor.graph.getAbsolutePosition(node.id)
+  let current: SceneNode | undefined = node
+  while (current && current.id !== editor.state.currentPageId) {
+    if (!current.visible || current.opacity === 0) return undefined
+    if (current.id !== node.id && current.clipsContent) {
+      const inverse = Matrix.invert(getWorldMatrix(current, editor.graph))
+      if (!inverse) return undefined
+      const [x, y] = Matrix.mapPoints(inverse, [at.x, at.y])
+      if (x < 0 || y < 0 || x > current.width || y > current.height) return undefined
+    }
+    current = current.parentId ? editor.graph.getNode(current.parentId) : undefined
+  }
+  return current ? at : undefined
+}
+
+export function useLocalFileBadges(editor: Editor, view: () => ViewportTransform, filterRevision: () => number) {
+  const anchors = computed(() => {
+    void editor.state.sceneVersion
+    void filterRevision()
+    const result = []
+    for (const node of editor.graph.nodes.values()) {
+      if (editor.graph.isViewHidden(node.id)) continue
+      const links = fileLinks(node)
+      if (!links.length) continue
+      const at = visibleAnchor(editor, node)
+      if (!at) continue
+      const missing = links.filter(link => link.availability === 'missing').length
+      const replaced = links.filter(link => link.availability === 'replaced').length
+      result.push({ id: node.id, uuid: localNodeId(node), at,
+        label: `本地 ${links.length}${missing ? ` · 缺失 ${missing}` : ''}${replaced ? ` · 待关联 ${replaced}` : ''}`,
+        description: `${node.name}：${links.map(link => `${link.path}（${({ available: '已关联', missing: '缺失', replaced: '待关联' })[link.availability]}）`).join('；')}`,
+        unavailable: missing + replaced > 0 })
+    }
+    return result
+  })
+  return computed(() => {
+    const viewport = view()
+    return anchors.value.map(badge => ({ ...badge,
+      x: badge.at.x * viewport.zoom + viewport.panX,
+      y: badge.at.y * viewport.zoom + viewport.panY }))
+  })
+}
diff --git a/src/app/document/local-file-nodes.ts b/src/app/document/local-file-nodes.ts
new file mode 100644
index 0000000..9ca7d94
--- /dev/null
+++ b/src/app/document/local-file-nodes.ts
@@ -0,0 +1,168 @@
+import * as v from 'valibot'
+import { localNodeId } from '@/app/document/local-identity'
+import type { Editor } from '@open-pencil/core/editor'
+import type { SceneNode } from '@open-pencil/scene-graph'
+
+export const fileEntrySchema = v.object({ id: v.string(), mountId: v.string(), path: v.string(),
+  kind: v.picklist(['file', 'directory', 'link', 'other']), size: v.string(), revision: v.number(),
+  availability: v.picklist(['available', 'missing', 'replaced']),
+  outputOrigin: v.optional(v.object({ operationId: v.string(), canvasId: v.string(),
+    nodeId: v.string(), sourceRevision: v.number(),
+    snapshotHash: v.optional(v.string()), snapshotFormat: v.optional(v.picklist(['png', 'txt', 'unknown'])) })) })
+type FileEntry = v.InferOutput<typeof fileEntrySchema>
+const LINK_KEY = 'os.canvas/fileLink'
+const OUTPUTS_KEY = 'os.canvas/outputLinks'
+const LABEL_KEY = 'os.canvas/fileLabel'
+const annotation = (key: string, value: string) => ({ pluginId: 'os.canvas', key, value })
+
+export function attachOutputOrigins(editor: Editor, entries: FileEntry[], canvasId: string) {
+  const nodes = new Map([...editor.graph.nodes.values()].map(node => [localNodeId(node), node]))
+  for (const entry of entries) {
+    const origin = entry.outputOrigin
+    if (!origin || origin.canvasId !== canvasId || entry.availability !== 'available') continue
+    const node = nodes.get(origin.nodeId)
+    if (!node || node.type === 'CANVAS' || fileLinks(node).some(link => link.id === entry.id && link.mountId === entry.mountId)) continue
+    // Preserve the user's primary reference; additional exports belong to the
+    // same artwork and participate in scanning without creating separate cards.
+    if (fileLink(node)) writeOutputLinks(editor, node, [...outputLinks(node), entry])
+    else editor.graph.updateNode(node.id, { pluginData: [...node.pluginData,
+      annotation(LINK_KEY, JSON.stringify(entry))] })
+  }
+}
+
+function refreshFileLink(editor: Editor, node: SceneNode, entry: FileEntry) {
+  const primary = fileLink(node)
+  if (primary?.id !== entry.id || primary.mountId !== entry.mountId) {
+    const links = outputLinks(node)
+    const updated = links.map(link => link.id === entry.id && link.mountId === entry.mountId ? entry : link)
+    if (JSON.stringify(links) !== JSON.stringify(updated)) writeOutputLinks(editor, node, updated)
+    return
+  }
+  const payload = JSON.stringify(entry)
+  const existing = node.pluginData.find(item => item.key === LINK_KEY && item.pluginId === 'os.canvas')
+  const ownsLabels = editor.graph.getChildren(node.id).some(child => child.pluginData.some(
+    item => item.key === LABEL_KEY && item.pluginId === 'os.canvas'))
+  if (existing?.value === payload && (!ownsLabels || node.name === entry.path)) return
+  editor.graph.updateNode(node.id, {
+    ...(ownsLabels ? { name: entry.path } : {}),
+    pluginData: [...node.pluginData.filter(item => item.key !== LINK_KEY || item.pluginId !== 'os.canvas'),
+      annotation(LINK_KEY, payload)]
+  })
+}
+
+export function fileLink(node: SceneNode) {
+  const raw = node.pluginData.find(item => item.pluginId === 'os.canvas' && item.key === LINK_KEY)
+  if (!raw) return undefined
+  const parsed = v.safeParse(v.pipe(v.string(), v.parseJson(), fileEntrySchema), raw.value)
+  return parsed.success ? parsed.output : undefined
+}
+
+function outputLinks(node: SceneNode): FileEntry[] {
+  const raw = node.pluginData.find(item => item.pluginId === 'os.canvas' && item.key === OUTPUTS_KEY)
+  if (!raw) return []
+  const parsed = v.safeParse(v.pipe(v.string(), v.parseJson(), v.array(fileEntrySchema)), raw.value)
+  return parsed.success ? parsed.output : []
+}
+
+function writeOutputLinks(editor: Editor, node: SceneNode, links: FileEntry[]) {
+  editor.graph.updateNode(node.id, { pluginData: [
+    ...node.pluginData.filter(item => item.key !== OUTPUTS_KEY || item.pluginId !== 'os.canvas'),
+    annotation(OUTPUTS_KEY, JSON.stringify(links))
+  ] })
+}
+
+export function fileLinks(node: SceneNode): FileEntry[] {
+  const primary = fileLink(node)
+  return primary ? [primary, ...outputLinks(node)] : outputLinks(node)
+}
+
+export function selectedFileLink(editor: Editor) {
+  const node = selectedFileNode(editor)
+  return node ? fileLink(node) : undefined
+}
+
+export function selectedFileNode(editor: Editor) {
+  const selected = [...editor.state.selectedIds]
+  let node = selected.length === 1 ? editor.graph.getNode(selected[0]) : undefined
+  while (node && !fileLink(node) && node.parentId) node = editor.graph.getNode(node.parentId)
+  return node && fileLink(node) ? node : undefined
+}
+
+export function referencedFileMounts(editor: Editor, root: string) {
+  const references = new Map<string, Set<string>>([[root, new Set()]])
+  for (const node of editor.graph.nodes.values()) {
+    for (const link of fileLinks(node)) {
+      const ids = references.get(link.mountId) ?? new Set<string>()
+      ids.add(link.id); references.set(link.mountId, ids)
+    }
+  }
+  return references
+}
+
+export function relinkFileNode(editor: Editor, nodeId: string, entry: FileEntry) {
+  const node = editor.graph.getNode(nodeId)
+  if (!node || !fileLink(node)) throw new Error('原节点已移除，未改变关联。')
+  const finish = editor.captureDocumentChange()
+  editor.graph.updateNode(node.id, { pluginData: [
+    ...node.pluginData.filter(item => item.key !== LINK_KEY || item.pluginId !== 'os.canvas'),
+    annotation(LINK_KEY, JSON.stringify(entry))
+  ] })
+  const result = reconcileFileNodes(editor, [entry], [entry.id], 'available')
+  const change = finish()
+  editor.pushUndoStep({ label: '重新关联文件',
+    inverse: () => editor.restoreDocumentChange(change, 'before'),
+    forward: () => editor.restoreDocumentChange(change, 'after') })
+  editor.requestRender()
+  return result.textIds
+}
+
+// External observations update only owned labels/link metadata. Geometry, selection,
+// other children, work content and the user's undo stack remain under the editor.
+export function reconcileFileNodes(editor: Editor, entries: FileEntry[], known: string[], mountAvailability: 'available' | 'offline' | 'replaced' | 'unavailable') {
+  const graph = editor.graph
+  const seen = new Set(known)
+  const nodes = [...graph.nodes.values()]
+  const linked = nodes.flatMap(node => fileLinks(node).map(link => ({ node, link })))
+  const pageId = editor.state.currentPageId
+  const children = graph.getChildren(pageId)
+  const startX = Math.max((340 - editor.state.panX) / editor.state.zoom,
+    ...children.map(node => node.x + node.width + 40))
+  const startY = (160 - editor.state.panY) / editor.state.zoom
+  let added = 0
+  const textIds: string[] = []
+  for (const entry of entries) {
+    const matches = linked.filter(item => item.link.id === entry.id && item.link.mountId === entry.mountId)
+    if (!matches.length && !seen.has(entry.id)) {
+      const frame = graph.createNode('FRAME', pageId, { name: entry.path,
+        x: startX + (added % 3) * 260, y: startY + Math.floor(added / 3) * 120,
+        width: 240, height: 100, clipsContent: true,
+        fills: [{ type: 'SOLID', color: { r: 0.12, g: 0.12, b: 0.12, a: 1 }, opacity: 1, visible: true }],
+        pluginData: [annotation(LINK_KEY, JSON.stringify(entry))] })
+      for (const [role, y, fontSize] of [['name', 16, 16], ['status', 56, 12]] as const) {
+        graph.createNode('TEXT', frame.id, { name: role, x: 14, y, width: 212, height: 28,
+          text: '', fontSize, fontFamily: 'Inter',
+          fills: [{ type: 'SOLID', color: { r: 0.92, g: 0.91, b: 0.88, a: 1 }, opacity: 1, visible: true }],
+          pluginData: [annotation(LABEL_KEY, role)] })
+      }
+      matches.push({ node: frame, link: entry }); added++
+    }
+    seen.add(entry.id)
+    const kind = { directory: '文件夹', link: '链接', file: '文件', other: '文件' }[entry.kind]
+    const state = mountAvailability === 'available'
+      ? { missing: '原件缺失', replaced: '需要重新关联', available: '已关联本地' }[entry.availability]
+      : { offline: '目录离线', replaced: '目录需要重新关联', unavailable: '目录不可访问' }[mountAvailability]
+    for (const { node } of matches) {
+      refreshFileLink(editor, node, entry)
+      const primary = fileLink(node)
+      if (primary?.id !== entry.id || primary.mountId !== entry.mountId) continue
+      for (const child of graph.getChildren(node.id)) {
+        const role = child.pluginData.find(item => item.key === LABEL_KEY && item.pluginId === 'os.canvas')?.value
+        const text = role === 'name' ? entry.path : (role === 'status' ? `[本地${kind}] ${state}` : undefined)
+        if (text !== undefined && child.text !== text) {
+          graph.updateNode(child.id, { text }); textIds.push(child.id)
+        }
+      }
+    }
+  }
+  return { knownFileAssets: [...seen], textIds }
+}
diff --git a/src/app/document/local-filter-session.ts b/src/app/document/local-filter-session.ts
