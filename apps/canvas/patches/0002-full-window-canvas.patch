diff --git a/packages/core/tests/editor/selection/view-filter.test.ts b/packages/core/tests/editor/selection/view-filter.test.ts
new file mode 100644
index 0000000..de0a0ad
--- /dev/null
+++ b/packages/core/tests/editor/selection/view-filter.test.ts
@@ -0,0 +1,39 @@
+import { expect, test } from 'bun:test'
+import { createEditor } from '@open-pencil/core/editor'
+import { extractExportGraph } from '@open-pencil/core/io'
+
+test('view exclusion protects descendant selection and hit targets without touching authored visibility', () => {
+  const editor = createEditor(), graph = editor.graph, page = editor.state.currentPageId
+  const back = graph.createNode('RECTANGLE', page, { x: 10, y: 10, width: 100, height: 100 })
+  const frame = graph.createNode('FRAME', page, { x: 10, y: 10, width: 100, height: 100 })
+  const child = graph.createNode('RECTANGLE', frame.id, { x: 0, y: 0, width: 80, height: 80,
+    fills: [{ type: 'SOLID', color: { r: 1, g: 0, b: 0, a: 1 }, opacity: 1, visible: true }] })
+  const before = JSON.stringify([...graph.nodes])
+  expect(graph.setViewHiddenNodes(new Set([frame.id]))).toBe(true)
+  expect(graph.setViewHiddenNodes(new Set([frame.id]))).toBe(false)
+  expect(graph.isViewHidden(child.id)).toBe(true)
+  expect(graph.hitTestDeep(30, 30, page)?.id).toBe(back.id)
+  editor.select([child.id])
+  expect(editor.state.selectedIds.size).toBe(0)
+  editor.selectAll()
+  expect([...editor.state.selectedIds]).toEqual([back.id])
+  editor.enterContainer(frame.id)
+  editor.validateEnteredContainer()
+  expect(editor.state.enteredContainerId).toBeNull()
+  expect(JSON.stringify([...graph.nodes])).toBe(before)
+  graph.setViewHiddenNodes(new Set())
+  expect(graph.hitTestDeep(30, 30, page)?.id).toBe(child.id)
+  editor.select([child.id])
+  expect([...editor.state.selectedIds]).toEqual([child.id])
+  expect(JSON.stringify([...graph.nodes])).toBe(before)
+})
+
+test('exports retain filtered-out content and do not inherit the transient view', () => {
+  const editor = createEditor(), graph = editor.graph
+  const node = graph.createNode('RECTANGLE', editor.state.currentPageId, { name: 'Retained artwork', width: 60, height: 30 })
+  graph.setViewHiddenNodes(new Set([node.id]))
+  const exported = extractExportGraph(graph, { scope: 'document' })
+  expect(exported.graph.getNode(node.id)?.name).toBe('Retained artwork')
+  expect(exported.graph.isViewHidden(node.id)).toBe(false)
+  expect(graph.isViewHidden(node.id)).toBe(true)
+})
