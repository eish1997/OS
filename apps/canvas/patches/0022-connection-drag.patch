@@ -0,0 +1,23 @@
+<script setup lang="ts">
+import type { ViewportTransform } from '@open-pencil/core/geometry'
+import { useEditorStore } from '@/app/editor/active-store'
+import { useConnectionDrag } from '@/app/document/local-connection-drag'
+const { drawn } = defineProps<{ drawn: ViewportTransform | null }>()
+const store = useEditorStore()
+const { handles, drag, begin, move, finish, cancel } = useConnectionDrag(store, () => drawn ?? store.state)
+</script>
+
+<template>
+  <div v-if="store.state.showUI && store.state.play === null" class="pointer-events-none absolute inset-0 z-10" aria-label="连接端点">
+    <button v-for="handle in handles" :key="handle.endpoint" type="button"
+      class="pointer-events-auto absolute size-3 -translate-x-1/2 -translate-y-1/2 rounded-full border border-border bg-accent touch-none"
+      :style="{ left: `${handle.x}px`, top: `${handle.y}px` }"
+      :aria-label="handle.endpoint === 'source' ? '拖动连接起点' : '拖动连接终点'"
+      @pointerdown.stop.prevent="begin(handle.endpoint, $event)" @pointermove.stop="move"
+      @pointerup.stop="finish" @pointercancel="cancel" @lostpointercapture="cancel"
+      @keydown.esc.stop.prevent="cancel" @click.stop />
+    <span v-if="drag" role="status" class="absolute bottom-12 left-3 rounded bg-panel p-2 text-xs text-surface">
+      {{ drag.candidate ? '松开以连接到此位置' : '拖到对象边缘吸附，Esc 取消' }}
+    </span>
+  </div>
+</template>
