@@ -0,0 +1,74 @@
+import type { Editor } from '@open-pencil/core/editor'
+import type { SceneNode } from '@open-pencil/scene-graph'
+
+const namespace = 'os.canvas'
+const key = 'os.canvas/nodeId'
+const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
+
+export function localNodeId(node: SceneNode | undefined): string | undefined {
+  const value = node?.pluginData.find(entry => entry.pluginId === namespace && entry.key === key)?.value
+  return value && uuid.test(value) ? value : undefined
+}
+
+export function createLocalIdentity(editor: Editor) {
+  // Keep deleted IDs reserved until the graph is replaced: redo restores the same identity,
+  // while a clone/paste gets a new graph ID and cannot claim the source's identity.
+  const assigned = new Map<string, string>()
+  const owners = new Map<string, string>()
+  function ensure(node: SceneNode) {
+    if (node.id === editor.graph.rootId) return
+    const parent = node.parentId ? editor.graph.getNode(node.parentId) : undefined
+    if (parent?.type === 'CANVAS' && parent.id !== editor.graph.rootId) ensure(parent)
+    const previous = localNodeId(node)
+    const identity = assigned.get(node.id) ??
+      (previous && !owners.has(previous) ? previous : crypto.randomUUID())
+    assigned.set(node.id, identity)
+    owners.set(identity, node.id)
+    if (previous === identity) return
+    editor.graph.updateNode(node.id, { pluginData: [
+      ...node.pluginData.filter(entry => !(entry.pluginId === namespace && entry.key === key)),
+      { pluginId: namespace, key, value: identity }
+    ] })
+  }
+  function ensureAll() { for (const node of editor.graph.nodes.values()) ensure(node) }
+  function pageIdentities() {
+    return editor.graph.getPages().map(page => ({ id: localNodeId(page), name: page.name }))
+  }
+  function restorePages(pages: readonly { id: string; name: string }[]) {
+    const actual = editor.graph.getPages()
+    if (actual.length !== pages.length || new Set(pages.map(page => page.id)).size !== pages.length ||
+        pages.some((page, index) => !uuid.test(page.id) || page.name !== actual[index].name)) {
+      throw new Error('页面身份清单与保存快照不匹配')
+    }
+    for (const [index, page] of actual.entries()) {
+      const identity = pages[index].id
+      const owner = owners.get(identity)
+      if (owner && owner !== page.id) throw new Error('页面身份与节点身份冲突')
+    }
+    for (const [index, page] of actual.entries()) {
+      const identity = pages[index].id
+      assigned.set(page.id, identity); owners.set(identity, page.id)
+      ensure(page)
+    }
+  }
+  function reset() {
+    assigned.clear(); owners.clear()
+    for (const node of editor.graph.nodes.values()) {
+      const identity = localNodeId(node)
+      if (identity && !owners.has(identity)) {
+        assigned.set(node.id, identity); owners.set(identity, node.id)
+      }
+    }
+  }
+  reset()
+  const stops = [
+    editor.onEditorEvent('node:created', ensure),
+    editor.onEditorEvent('node:updated', (id, changes) => {
+      if (!changes.pluginData) return
+      const node = editor.graph.getNode(id)
+      if (node) ensure(node)
+    }),
+    editor.onEditorEvent('graph:replaced', reset)
+  ]
+  return { ensureAll, pageIdentities, restorePages, dispose: () => { for (const stop of stops) stop() } }
+}
