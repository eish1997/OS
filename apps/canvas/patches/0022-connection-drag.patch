diff --git a/src/app/document/local-connection-drag.ts b/src/app/document/local-connection-drag.ts
new file mode 100644
--- /dev/null
+++ b/src/app/document/local-connection-drag.ts
@@ -0,0 +1,75 @@
+import { computed, ref, watch } from 'vue'
+import type { Editor } from '@open-pencil/core/editor'
+import type { ViewportTransform } from '@open-pencil/core/geometry'
+import { getWorldMatrix } from '@open-pencil/scene-graph/coordinate'
+import Matrix from '@open-pencil/scene-graph/matrix'
+import { anchorPoint, anchorSides, relation } from './local-connection-data'
+import type { AnchorSide } from './local-connection-data'
+import { localNodeId } from './local-identity'
+import { useConnectionEdit } from './local-connection-edit'
+
+type Endpoint = 'source' | 'target'
+type Anchor = { uuid: string; side: AnchorSide; x: number; y: number }
+
+export function useConnectionDrag(editor: Editor, view: () => ViewportTransform) {
+  const { selected, setAnchor } = useConnectionEdit(editor)
+  const drag = ref<{ endpoint: Endpoint; pointer: number; x: number; y: number; candidate?: Anchor }>()
+  const anchors = computed(() => {
+    void editor.state.sceneVersion
+    const transform = view(), found: Anchor[] = []
+    function visit(id: string) {
+      const node = editor.graph.getNode(id)
+      if (!node || !node.visible || node.locked || editor.graph.isViewHidden(id)) return
+      const uuid = localNodeId(node)
+      if (uuid && !relation(node)) for (const side of anchorSides) {
+        const [x, y] = Matrix.mapPoints(getWorldMatrix(node, editor.graph), anchorPoint(node, side))
+        found.push({ uuid, side, x: x * transform.zoom + transform.panX, y: y * transform.zoom + transform.panY })
+      }
+      for (const child of node.childIds) visit(child)
+    }
+    for (const node of editor.graph.getChildren(editor.state.currentPageId)) visit(node.id)
+    return found
+  })
+  const handles = computed(() => {
+    const current = selected.value
+    if (!current || current.locked || editor.graph.isViewHidden(current.id)) return []
+    return (['source', 'target'] as const).flatMap(endpoint => {
+      const side = endpoint === 'source' ? current.link.sourceAnchor ?? 'right' : current.link.targetAnchor ?? 'left'
+      const anchor = anchors.value.find(a => a.uuid === current.link[endpoint] && a.side === side)
+      if (!anchor) return []
+      const active = drag.value?.endpoint === endpoint ? drag.value : undefined
+      return [{ endpoint, x: active?.x ?? anchor.x, y: active?.y ?? anchor.y }]
+    })
+  })
+  function cancel() { drag.value = undefined }
+  watch(() => [selected.value?.id, JSON.stringify(selected.value?.link), editor.state.currentPageId, editor.state.play], cancel)
+  function begin(endpoint: Endpoint, event: PointerEvent) {
+    if (event.button !== 0 || !selected.value || selected.value.locked) return
+    const handle = handles.value.find(h => h.endpoint === endpoint)
+    if (!handle) return
+    const element = event.currentTarget as HTMLElement
+    element.focus(); element.setPointerCapture(event.pointerId)
+    drag.value = { endpoint, pointer: event.pointerId, x: handle.x, y: handle.y }
+  }
+  function move(event: PointerEvent) {
+    const active = drag.value
+    if (!active || active.pointer !== event.pointerId) return
+    const bounds = (event.currentTarget as HTMLElement).parentElement?.getBoundingClientRect()
+    if (!bounds) return
+    const x = event.clientX - bounds.left, y = event.clientY - bounds.top
+    let candidate: Anchor | undefined, nearest = 14
+    for (const anchor of anchors.value) {
+      const distance = Math.hypot(anchor.x - x, anchor.y - y)
+      if (distance < nearest) { nearest = distance; candidate = anchor }
+    }
+    drag.value = { ...active, candidate, x: candidate?.x ?? x, y: candidate?.y ?? y }
+  }
+  function finish(event: PointerEvent) {
+    if (drag.value?.pointer !== event.pointerId) return
+    move(event)
+    const active = drag.value
+    cancel()
+    if (active.candidate) setAnchor(active.endpoint, active.candidate.side, active.candidate.uuid)
+  }
+  return { handles, drag, begin, move, finish, cancel }
+}
