# Copy to .env. Values stay on the server. Do not commit credentials.
PORT=4310
DATA_DIR=./data
# Required for login; generate a strong password locally.
WORKBENCH_PASSWORD=
# Optional remote deployment: HTTPS public origin, behind a trusted TLS proxy.
PUBLIC_ORIGIN=http://127.0.0.1:4310
# Outbound network: auto reuses explicit proxy env, then Windows enabled static proxy.
# environment uses only HTTP_PROXY/HTTPS_PROXY; direct opts out. Local traffic bypasses.
WORKBENCH_PROXY_MODE=auto
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
# Optional paid API path. ChatGPT subscription is configured in local Settings,
# with its own protected OAuth credentials and explicit usage consent; no API key required.
# A selected subscription never automatically falls back to these API settings.
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-5
PI_API_KEY=
# Default 0 disables real calls. Set after agreeing a verification budget.
PI_MAX_CALLS=0
PI_MAX_OUTPUT_TOKENS=2048
PI_CALL_RESERVE_USD=1
PI_BUDGET_USD=0
PI_TIMEOUT_MS=120000
# Local node credentials come from pairing, not from a browser model key.
NODE_SERVER=http://127.0.0.1:4310
NODE_ID=
NODE_TOKEN=
NODE_ALLOWED_DIR=./data/node-workspace
# Storage admission limits (bytes). Keep a recovery reserve for login/cancel/reconciliation.
DATA_MAX_BYTES=2147483648
DATABASE_MAX_BYTES=805306368
ASSET_MAX_BYTES=524288000
UPLOAD_TEMP_MAX_BYTES=20971520
# One max-size native session plus one fork copy, with 16MiB growth slack.
SESSION_MAX_BYTES=285212672
WORKSPACE_MAX_BYTES=67108864
LOG_MAX_BYTES=4194304
PLUGIN_MAX_BYTES=536870912
STORAGE_MIN_FREE_BYTES=67108864
STORAGE_CONTROL_RESERVE_BYTES=4194304
NODE_STORAGE_MAX_BYTES=67108864
# Optional independent backup volume. On this Windows workstation, an already
# owned USERPROFILE/AI-OS-Backups directory is discovered without configuration.
# Default: daily when idle, keep 7 verified recovery points; 8GiB/12GiB reserve.
# BACKUP_DIR=
