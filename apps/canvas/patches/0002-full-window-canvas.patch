diff --git a/vite/os-workspace.ts b/vite/os-workspace.ts
new file mode 100644
index 0000000..abece25
--- /dev/null
+++ b/vite/os-workspace.ts
@@ -0,0 +1,50 @@
+import type { Plugin, ViteDevServer } from 'vite'
+
+// The local host owns the token; it is never bundled into renderer code.
+export function osWorkspacePlugin(): Plugin {
+    function configure(server: Pick<ViteDevServer, 'middlewares'>) {
+      server.middlewares.use('/os-workspace', async (request, response) => {
+        const token = process.env.OS_CANVAS_TOKEN
+        const target = process.env.OS_CANVAS_SERVICE_URL
+        const origin = process.env.OPENPENCIL_DEV_ORIGIN
+        if (!token || !target || !origin) {
+          response.writeHead(503); response.end('Local workspace is not running'); return
+        }
+        if (request.headers.host !== new URL(origin).host ||
+            (request.headers.origin && request.headers.origin !== origin) ||
+            request.headers['x-os-workspace'] !== '1') {
+          response.writeHead(403); response.end('Workspace request rejected'); return
+        }
+        try {
+          let body: Uint8Array | undefined
+          if (request.method === 'POST') {
+            const chunks: Buffer[] = []
+            let size = 0
+            for await (const chunk of request) {
+              const bytes = Buffer.from(chunk)
+              size += bytes.length
+              if (size > 350 * 1024 * 1024) {
+                response.writeHead(413); response.end('Request too large'); return
+              }
+              chunks.push(bytes)
+            }
+            body = new Uint8Array(Buffer.concat(chunks))
+          }
+          const result = await fetch(`${target}${request.url ?? '/'}`, {
+            method: request.method, body,
+            headers: { Authorization: `Bearer ${token}`, Origin: origin,
+              'Content-Type': request.headers['content-type'] ?? 'application/json' },
+            signal: AbortSignal.timeout(30000)
+          })
+          response.writeHead(result.status, {
+            'Content-Type': result.headers.get('content-type') ?? 'application/json',
+            'Cache-Control': 'no-store'
+          })
+          response.end(Buffer.from(await result.arrayBuffer()))
+        } catch {
+          response.writeHead(503); response.end('Local workspace is unavailable')
+        }
+      })
+    }
+  return { name: 'os-workspace', configureServer: configure, configurePreviewServer: configure }
+}
