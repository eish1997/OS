+++ b/src/app/document/local-connection-data.ts
@@ -0,0 +1,18 @@
+import type { SceneNode } from '@open-pencil/scene-graph'
+
+export const pluginId = 'os.canvas'
+export const key = 'os.canvas/connection'
+type Connection = { version: 1; source: string; target: string }
+
+export function relation(node: SceneNode): Connection | undefined {
+  const raw = node.pluginData.find(item => item.pluginId === pluginId && item.key === key)?.value
+  if (!raw) return undefined
+  try {
+    const value: unknown = JSON.parse(raw)
+    if (typeof value !== 'object' || value === null) return undefined
+    if ('version' in value && value.version === 1 && 'source' in value && typeof value.source === 'string' &&
+      'target' in value && typeof value.target === 'string') return value as Connection
+  } catch { console.warn('关系连接元数据无法解析，原数据已保留。') }
+  return undefined
+}
+
