@@ -0,0 +1,23 @@
+<script setup lang="ts">
+import { useEditorStore } from '@/app/editor/active-store'
+import { useConnectionEdit } from '@/app/document/local-connection-edit'
+import { anchorSides } from '@/app/document/local-connection-data'
+import AppButton from '@/components/ui/button/AppButton.vue'
+
+const { selected, setAnchor } = useConnectionEdit(useEditorStore())
+const labels = { top: '上', right: '右', bottom: '下', left: '左' }
+const endpoints = ['source', 'target'] as const
+</script>
+
+<template>
+  <section v-if="selected" aria-label="连接锚点" class="border-b border-border p-3 text-xs">
+    <p class="mb-2">连接位置</p>
+    <div v-for="endpoint in endpoints" :key="endpoint" class="mb-1 flex items-center gap-1">
+      <span>{{ endpoint === 'source' ? '起点' : '终点' }}</span>
+      <AppButton v-for="side in anchorSides" :key="side" class="aria-pressed:bg-accent aria-pressed:text-on-accent" :disabled="selected.locked"
+        :aria-label="`${endpoint === 'source' ? '起点' : '终点'}连接${labels[side]}侧`"
+        :aria-pressed="(selected.link[endpoint === 'source' ? 'sourceAnchor' : 'targetAnchor'] ?? (endpoint === 'source' ? 'right' : 'left')) === side"
+        @click="setAnchor(endpoint, side)">{{ labels[side] }}</AppButton>
+    </div>
+  </section>
+</template>
