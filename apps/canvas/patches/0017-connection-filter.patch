+  // Filtering is a view projection. Keep connected artwork intact on disk,
+  // but hide its line whenever a present endpoint is outside the visible tree.
+  const displayed = new Set<string>()
+  function visit(node: SceneNode) {
+    if (!node.visible || displayed.has(node.id)) return
+    displayed.add(node.id)
+    for (const child of graph.getChildren(node.id)) visit(child)
+  }
+  for (const root of roots) if (shown.has(root.id)) visit(root)
+  const identities = new Map([...graph.nodes.values()].map(node => [localNodeId(node), node]))
+  for (const id of displayed) {
+    const node = graph.getNode(id)
+    if (!node) continue
+    const link = relation(node)
+    if (!link) continue
+    const concealed = [link.source, link.target].some(identity => {
+      const endpoint = identities.get(identity)
+      return endpoint && !displayed.has(endpoint.id)
+    })
+    if (concealed) { hidden.add(id); shown.delete(id) }
+  }
   return { shown, hidden, total: roots.length }
 }
