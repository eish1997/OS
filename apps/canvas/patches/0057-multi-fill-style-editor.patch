diff --git a/src/components/properties/shared-style/fill-draft.ts b/src/components/properties/shared-style/fill-draft.ts
new file mode 100644
--- /dev/null
+++ b/src/components/properties/shared-style/fill-draft.ts
@@ -0,0 +1,20 @@
+import { copyFills, type Fill } from '@open-pencil/scene-graph'
+export interface FillDraft { source: Fill; hex: string; opacity: string | number; visible: boolean }
+export function fillDrafts(fills: Fill[]): FillDraft[] {
+  return copyFills(fills).map(source => ({ source, visible: source.visible, opacity: source.opacity * 100,
+    hex: [source.color.r, source.color.g, source.color.b].map(value => Math.round(value * 255).toString(16).padStart(2, '0')).join('').toUpperCase()
+  }))
+}
+export function readFills(drafts: FillDraft[]): Fill[] {
+  return drafts.map((draft, index) => {
+    const hex = draft.hex.trim().replace(/^#/, '')
+    const opacity = Number(draft.opacity)
+    if (!String(draft.opacity).trim() || !Number.isFinite(opacity) || opacity < 0 || opacity > 100) throw new Error(`填充 ${index + 1}：透明度必须为 0–100`)
+    if (draft.source.type === 'SOLID' && !/^[0-9a-f]{6}$/i.test(hex)) throw new Error(`填充 ${index + 1}：请输入六位十六进制颜色`)
+    const fill = copyFills([draft.source])[0]
+    fill.opacity = opacity / 100
+    fill.visible = draft.visible
+    if (fill.type === 'SOLID') fill.color = { ...fill.color, r: Number.parseInt(hex.slice(0, 2), 16) / 255, g: Number.parseInt(hex.slice(2, 4), 16) / 255, b: Number.parseInt(hex.slice(4, 6), 16) / 255 }
+    return fill
+  })
+}
diff --git a/src/components/properties/shared-style/FillStyleFields.vue b/src/components/properties/shared-style/FillStyleFields.vue
new file mode 100644
--- /dev/null
+++ b/src/components/properties/shared-style/FillStyleFields.vue
@@ -0,0 +1,30 @@
+<script setup lang="ts">
+import type { FillDraft } from './fill-draft'
+import { fillDrafts } from './fill-draft'
+import AppInput from '@/components/ui/input/AppInput.vue'
+import AppButton from '@/components/ui/button/AppButton.vue'
+import AppCheckbox from '@/components/ui/toggle/AppCheckbox.vue'
+const fills = defineModel<FillDraft[]>({ required: true })
+function add() { fills.value.push(...fillDrafts([{ type: 'SOLID', color: { r: 1, g: 1, b: 1, a: 1 }, opacity: 1, visible: true }])) }
+function move(index: number, direction: number) {
+  const next = index + direction
+  if (next < 0 || next >= fills.value.length) return
+  const [fill] = fills.value.splice(index, 1)
+  fills.value.splice(next, 0, fill)
+}
+</script>
+<template>
+  <div v-for="(fill, index) in fills" :key="index" class="flex flex-col gap-2" :data-style-fill="index">
+    <span class="text-xs text-muted">填充 {{ index + 1 }}</span>
+    <label v-if="fill.source.type === 'SOLID'" class="text-xs text-muted">颜色<AppInput v-model="fill.hex" :aria-label="index === 0 ? '样式颜色' : `填充 ${index + 1} 颜色`" size="sm" /></label>
+    <span v-else class="text-xs text-muted">保留原填充内容</span>
+    <label class="text-xs text-muted">透明度 %<AppInput v-model="fill.opacity" :aria-label="`填充 ${index + 1} 透明度`" type="number" size="sm" /></label>
+    <div class="flex items-center gap-2">
+      <AppCheckbox v-model="fill.visible" :aria-label="`填充 ${index + 1} 可见`" />
+      <AppButton size="xs" :disabled="index === 0" :aria-label="`上移填充 ${index + 1}`" @click="move(index, -1)">上移</AppButton>
+      <AppButton size="xs" :disabled="index === fills.length - 1" :aria-label="`下移填充 ${index + 1}`" @click="move(index, 1)">下移</AppButton>
+      <AppButton size="xs" :aria-label="`删除填充 ${index + 1}`" @click="fills.splice(index, 1)">删除</AppButton>
+    </div>
+  </div>
+  <AppButton size="sm" @click="add">添加样式填充</AppButton>
+</template>
