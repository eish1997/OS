+++ b/src/components/properties/shared-style/EffectStyleFields.vue
@@ -0,0 +1,29 @@
+<script setup lang="ts">
+import type { EffectDraft } from './effect-draft'
+import { effectDrafts } from './effect-draft'
+import AppInput from '@/components/ui/input/AppInput.vue'
+import AppButton from '@/components/ui/button/AppButton.vue'
+import AppSelect from '@/components/ui/select/AppSelect.vue'
+import AppCheckbox from '@/components/ui/toggle/AppCheckbox.vue'
+const effects = defineModel<EffectDraft[]>({ required: true })
+const types = [{ value: 'DROP_SHADOW', label: '投影' }, { value: 'INNER_SHADOW', label: '内阴影' }, { value: 'LAYER_BLUR', label: '图层模糊' }, { value: 'BACKGROUND_BLUR', label: '背景模糊' }, { value: 'FOREGROUND_BLUR', label: '前景模糊' }]
+const fields = [{ key: 'alpha', label: '透明度 %' }, { key: 'radius', label: '模糊' }, { key: 'x', label: '水平偏移' }, { key: 'y', label: '垂直偏移' }, { key: 'spread', label: '扩展' }] as const
+function add() {
+  effects.value.push(...effectDrafts([{ type: 'DROP_SHADOW', color: { r: 0, g: 0, b: 0, a: 0.25 }, offset: { x: 0, y: 4 }, radius: 8, spread: 0, visible: true }]))
+}
+</script>
+<template>
+  <div v-for="(effect, index) in effects" :key="index" class="flex flex-col gap-2" :data-style-effect="index">
+    <AppSelect v-model="effect.type" :options="types" :label="`效果 ${index + 1} 类型`" />
+    <label class="text-xs text-muted">颜色<AppInput v-model="effect.hex" :aria-label="`效果 ${index + 1} 颜色`" size="sm" /></label>
+    <div class="grid grid-cols-2 gap-2">
+      <label v-for="field in fields" :key="field.key" class="text-xs text-muted">{{ field.label }}<AppInput v-model="effect[field.key]" :aria-label="`效果 ${index + 1} ${field.label}`" type="number" size="sm" /></label>
+    </div>
+    <div class="flex items-center gap-2">
+      <AppCheckbox v-model="effect.visible" :aria-label="`效果 ${index + 1} 可见`" />
+      <span class="text-xs text-muted">可见</span>
+      <AppButton size="xs" :aria-label="`删除效果 ${index + 1}`" @click="effects.splice(index, 1)">删除</AppButton>
+    </div>
+  </div>
+  <AppButton size="sm" @click="add">添加样式效果</AppButton>
+</template>
