@@ -0,0 +1,25 @@
+import { BUILTIN_IO_FORMATS, IORegistry } from '@open-pencil/core/io'
+import { exportFigFile } from '@open-pencil/core/io/formats/fig'
+import { sceneGraphFromStyledHTML } from '@open-pencil/core/io/formats/html/layers'
+import { browserHTMLToDesignDocument } from '@open-pencil/dom-css/browser'
+import { readFigDocument } from '@/app/document/io/fig'
+import { getLocalWorkspace } from '@/app/document/local-workspace'
+import type { EditorStore } from '@/app/editor/session'
+
+const io = new IORegistry(BUILTIN_IO_FORMATS)
+export async function importEmbeddedFile(store: EditorStore, file: File) {
+    const name = file.name.replace(/\.[^.]+$/i, '')
+    let scene: Uint8Array
+    if (file.name.toLowerCase().endsWith('.fig')) {
+      // Decode first so corrupt files never become an active document.
+      await readFigDocument(file)
+      scene = new Uint8Array(await file.arrayBuffer())
+    } else {
+      const graph = /\.(html?|xhtml)$/i.test(file.name)
+        ? sceneGraphFromStyledHTML(await browserHTMLToDesignDocument(await file.text()), { pageName: name })
+        : (await io.readDocument({ name: file.name, mimeType: file.type || undefined,
+            data: new Uint8Array(await file.arrayBuffer()) })).graph
+      scene = await exportFigFile(graph)
+    }
+    await getLocalWorkspace(store).importForBridge(scene, name)
+}
