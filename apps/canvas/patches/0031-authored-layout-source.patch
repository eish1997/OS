+test('edited layout geometry invalidates saved source size, derived loading preserves it', () => {
+  const graph = new SceneGraph()
+  const node = graph.createNode('FRAME', pageId(graph), { width: 240, height: 200 })
+  graph.applyDerivedLayoutDuring(() => graph.withLayoutMutations(() => graph.updateNode(node.id, { height: 300 })))
+  expect(node.source.editedFields).not.toContain('height')
+  graph.withLayoutMutations(() => graph.updateNode(node.id, { height: 890 }))
+  expect(node.source.editedFields).toContain('height')
+})
