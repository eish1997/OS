--- /dev/null
+++ b/src/app/document/local-connection-route.ts
@@ -0,0 +1,30 @@
+import type { SceneNode, VectorNetwork } from '@open-pencil/scene-graph'
+import type { ConnectionRoute } from './local-connection-data'
+
+/** A midpoint route in the connector parent's coordinates; no obstacle routing yet. */
+export function connectionNetwork(points: number[], route: ConnectionRoute = 'straight'): VectorNetwork {
+  const [x1, y1, x2, y2] = points
+  const start = { x: x1, y: y1 }, end = { x: x2, y: y2 }
+  const middle = (x1 + x2) / 2
+  const vertices = route === 'elbow' ? [start, { x: middle, y: y1 }, { x: middle, y: y2 }, end] : [start, end]
+  const segments = vertices.slice(1).map((_, i) => ({ start: i, end: i + 1,
+    tangentStart: { x: 0, y: 0 }, tangentEnd: { x: 0, y: 0 } }))
+  if (route === 'curve') {
+    segments[0].tangentStart = { x: middle - x1, y: 0 }
+    segments[0].tangentEnd = { x: middle - x2, y: 0 }
+  }
+  return { vertices, segments, regions: [] }
+}
+
+const near = (a: number, b: number) => Math.abs(a - b) < 0.00001
+export function sameConnectionNetwork(node: SceneNode, network: VectorNetwork) {
+  const old = node.vectorNetwork
+  if (!old || old.vertices.length !== network.vertices.length || old.segments.length !== network.segments.length) return false
+  if (!network.vertices.every((v, i) => near(v.x, old.vertices[i].x) && near(v.y, old.vertices[i].y))) return false
+  return network.segments.every((s, i) => {
+    const previous = old.segments[i]
+    return s.start === previous.start && s.end === previous.end &&
+      near(s.tangentStart.x, previous.tangentStart.x) && near(s.tangentStart.y, previous.tangentStart.y) &&
+      near(s.tangentEnd.x, previous.tangentEnd.x) && near(s.tangentEnd.y, previous.tangentEnd.y)
+  })
+}
