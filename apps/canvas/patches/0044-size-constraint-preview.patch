--- /dev/null
+++ b/packages/vue/src/controls/layout/size-preview.ts
@@ -0,0 +1,65 @@
+import { tryOnScopeDispose } from '@vueuse/core'
+import { getCurrentInstance, onDeactivated } from 'vue'
+
+import type { Editor, NodePreview } from '@open-pencil/core/editor'
+import type { SceneNode } from '@open-pencil/scene-graph'
+import {
+  computeConstrainedResizeChanges,
+  createResizeSnapshot,
+  type ResizeSnapshot
+} from '@open-pencil/scene-graph/resize'
+
+/** Numeric resizing owns a single baseline and one history entry for the whole subtree. */
+export function useSizePreview(editor: Editor) {
+  let preview: NodePreview | undefined
+  let rootId = ''
+  let before = { width: 0, height: 0 }
+  const originals = new Map<string, ResizeSnapshot>()
+
+  function capture(id: string) {
+    for (const child of editor.graph.getChildren(id)) {
+      originals.set(child.id, createResizeSnapshot(child))
+      capture(child.id)
+    }
+  }
+
+  function cancel() {
+    preview?.cancel()
+    preview = undefined
+    originals.clear()
+  }
+
+  function update(id: string, patch: Partial<SceneNode>, label: string) {
+    if (preview?.closed || (preview && rootId !== id)) cancel()
+    const node = editor.graph.getNode(id)
+    if (!node) return
+    if (!preview) {
+      rootId = id
+      before = { width: node.width, height: node.height }
+      capture(id)
+      preview = editor.beginNodePreview(label)
+    }
+    try {
+      preview.update(id, patch)
+      if (before.width > 0 && before.height > 0) {
+        const changes = computeConstrainedResizeChanges(
+          editor.graph, id, before, node, originals
+        )
+        for (const [childId, change] of changes) preview.update(childId, change)
+      }
+    } catch (error) {
+      cancel()
+      throw error
+    }
+  }
+
+  function commit() {
+    preview?.commit()
+    preview = undefined
+    originals.clear()
+  }
+
+  tryOnScopeDispose(cancel)
+  if (getCurrentInstance()) onDeactivated(cancel)
+  return { update, commit, cancel }
+}
