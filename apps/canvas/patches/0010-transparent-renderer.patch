diff --git a/tests/engine/core/editor/desktop-transparency.test.ts b/tests/engine/core/editor/desktop-transparency.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/engine/core/editor/desktop-transparency.test.ts
@@ -0,0 +1,38 @@
+import { expect, test } from 'bun:test'
+import { SkiaRenderer } from '@open-pencil/core/canvas'
+import { createEditor } from '@open-pencil/core/editor'
+import { initCanvasKit } from '@open-pencil/core/io'
+
+test('desktop mode follows both layers and recreated renderers without changing page color', async () => {
+  const ck = await initCanvasKit()
+  const editor = createEditor()
+  const renderers: SkiaRenderer[] = []
+  const pageColor = { ...editor.state.pageColor }
+  const attach = () => {
+    const surface = ck.MakeSurface(16, 16)
+    if (!surface) throw new Error('CanvasKit surface unavailable')
+    const renderer = new SkiaRenderer(ck, surface)
+    renderers.push(renderer)
+    editor.setCanvasKit(ck, renderer)
+    return renderer
+  }
+  try {
+    const scene = attach()
+    const overlay = attach()
+    expect(scene.desktopTransparent).toBe(false)
+    editor.setDesktopTransparent(true)
+    expect(scene.desktopTransparent).toBe(true)
+    expect(overlay.desktopTransparent).toBe(true)
+    editor.removeCanvasRenderer(scene)
+    const recreated = attach()
+    expect(recreated.desktopTransparent).toBe(true)
+    editor.setDesktopTransparent(false)
+    expect(recreated.desktopTransparent).toBe(false)
+    expect(overlay.desktopTransparent).toBe(false)
+    expect(attach().desktopTransparent).toBe(false)
+    expect(editor.state.pageColor).toEqual(pageColor)
+  } finally {
+    editor.dispose()
+    for (const renderer of renderers) renderer.destroy()
+  }
+})
