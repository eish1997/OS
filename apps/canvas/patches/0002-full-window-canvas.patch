@@ -0,0 +1,62 @@
+import { workspaceFetch } from '@/app/document/workspace-fetch'
+import { ref } from 'vue'
+import * as v from 'valibot'
+import type { Editor } from '@open-pencil/core/editor'
+import { selectedFileLink } from '@/app/document/local-file-nodes'
+
+const previewSchema = v.object({ token: v.string(), mountId: v.string(), assetId: v.string(),
+  path: v.string(), kind: v.string(), size: v.string(), revision: v.number() })
+
+export function createLocalReplacement(editor: Editor, mountId: () => string, refresh: () => Promise<void>) {
+  const preview = ref<v.InferOutput<typeof previewSchema>>()
+  const busy = ref(false)
+  const error = ref('')
+  let generation = 0
+  let disposed = false
+  const isCurrent = (value: number) => !disposed && generation === value
+  function cancel() { generation++; preview.value = undefined; error.value = '' }
+  const stopSelection = editor.onEditorEvent('selection:changed', cancel)
+  const stopGraph = editor.onEditorEvent('graph:replaced', cancel)
+  async function call(path: string, token?: string) {
+    const response = await workspaceFetch(`/os-workspace${path}`, { method: 'POST',
+      headers: { 'X-OS-Workspace': '1', 'Content-Type': 'application/json' },
+      body: token ? JSON.stringify({ token }) : undefined, signal: AbortSignal.timeout(30000) })
+    if (!response.ok) throw new Error(response.status === 409
+      ? '原件或关联已变化，请重新预览后确认。'
+      : '无法处理关联，请保留当前内容后重试。')
+    return response
+  }
+  async function prepare() {
+    if (busy.value) return
+    cancel()
+    const link = selectedFileLink(editor)
+    if (link?.availability !== 'replaced' || link.mountId !== mountId() || !['file', 'directory'].includes(link.kind)) {
+      error.value = '请选中标记为“需要重新关联”的本地文件或文件夹。本入口确认同路径的新原件。'; return
+    }
+    const current = generation
+    busy.value = true
+    try {
+      const response = await call(`/mounts/${link.mountId}/files/${link.id}/replacement-preview`)
+      const result = v.parse(v.pipe(v.string(), v.parseJson(), previewSchema), await response.text())
+      if (isCurrent(current)) preview.value = result
+    } catch (cause) {
+      if (isCurrent(current)) error.value = cause instanceof Error ? cause.message : '无法预览原件'
+    } finally { busy.value = false }
+  }
+  async function confirm() {
+    const candidate = preview.value
+    if (!candidate || busy.value) return
+    const current = generation
+    busy.value = true; error.value = ''
+    try {
+      await call(`/mounts/${candidate.mountId}/files/${candidate.assetId}/replacement-confirm`, candidate.token)
+      if (!isCurrent(current)) return
+      preview.value = undefined
+      await refresh()
+    } catch (cause) {
+      if (isCurrent(current)) error.value = cause instanceof Error ? cause.message : '无法确认关联'
+    } finally { busy.value = false }
+  }
+  function dispose() { disposed = true; cancel(); stopSelection(); stopGraph() }
+  return { preview, busy, error, prepare, confirm, cancel, dispose }
+}
diff --git a/src/app/document/local-workspace.ts b/src/app/document/local-workspace.ts
new file mode 100644
index 0000000..ff0e28a
--- /dev/null
+++ b/src/app/document/local-workspace.ts
@@ -0,0 +1,440 @@
+import { workspaceFetch } from '@/app/document/workspace-fetch'
+import { fromUint8Array } from 'js-base64'
+import * as v from 'valibot'
+import { computed, ref, watch } from 'vue'
+import type { Editor } from '@open-pencil/core/editor'
+import { exportFigFile } from '@open-pencil/core/io/formats/fig'
+import { SceneGraph } from '@open-pencil/scene-graph'
+import { setPageBackgrounds } from '@open-pencil/core/figma-api'
+import { PAGE_DEFAULT_BACKGROUNDS } from '@open-pencil/core/constants'
+import { createDocumentChanges } from '@/app/document/io/changes'
+import { createLocalIdentity, localNodeId } from '@/app/document/local-identity'
+import { readFigDocument } from '@/app/document/io/fig'
+import { applyImportedDocument } from '@/app/document/io/imported-document'
+import { attachOutputOrigins, fileEntrySchema, referencedFileMounts, selectedFileLink, reconcileFileNodes } from '@/app/document/local-file-nodes'
+import { ensureGraphFonts } from '@/app/editor/fonts'
+import { createLocalReplacement } from '@/app/document/local-replacement'
+import { createLocalRelink } from '@/app/document/local-relink'
+import { createLocalMountRelink } from '@/app/document/local-mount-relink'
+import { createLocalOutput } from '@/app/document/local-output'
+import { createLocalPackages } from '@/app/document/local-packages'
+import { createLocalFilter } from '@/app/document/local-filter-session'
+
+type LocalEditor = Editor & {
+  state: Editor['state'] & { documentName: string; autosaveEnabled: boolean }
+  hasUnsavedChanges(): boolean
+  markDocumentSaved(): void
+  protectSavedRecovery(): Promise<void>
+  saveFigFile(): Promise<boolean>
+  openFigFile(file: File): Promise<void>
+  setDocumentSource(fileName: string, sourceFormat: string): void
+  renderExportImage(ids: string[], scale: number, format: 'PNG'): Promise<Uint8Array | null>
+}
+
+const sessions = new WeakMap<LocalEditor, ReturnType<typeof createLocalWorkspace>>()
+export function getLocalWorkspace(store: LocalEditor) {
+  const session = sessions.get(store)
+  if (!session) throw new Error('Local workspace session was not installed')
+  return session
+}
+export function installLocalWorkspace(store: LocalEditor) {
+  const session = createLocalWorkspace(store)
+  sessions.set(store, session)
+  store.saveFigFile = session.save
+  store.hasUnsavedChanges = session.hasUnsavedChanges
+  const dispose = store.dispose.bind(store)
+  store.dispose = () => { session.dispose(); sessions.delete(store); dispose() }
+}
+
+const savedSchema = v.object({ canvasId: v.string(), revision: v.number() })
+const finite = v.pipe(v.number(), v.finite())
+const viewSchema = v.looseObject({ pageId: v.optional(v.string()), panX: finite, panY: finite,
+  zoom: v.pipe(finite, v.minValue(0.02), v.maxValue(256)) })
+const metadataSchema = v.looseObject({ formatVersion: v.literal(1), name: v.string(), view: v.optional(viewSchema),
+  pages: v.optional(v.array(v.looseObject({ id: v.string(), name: v.string() }))) })
+// Listing needs only the envelope; validate the supported payload before opening it.
+const documentSchema = v.object({ canvasId: v.string(), revision: v.number(),
+  metadata: v.looseObject({ formatVersion: finite, name: v.string() }) })
+type StoredDocument = v.InferOutput<typeof documentSchema>
+const mountSchema = v.object({ id: v.string(), canvasId: v.string(), path: v.string(),
+  availability: v.picklist(['available', 'offline', 'replaced', 'unavailable']) })
+type StoredMount = v.InferOutput<typeof mountSchema>
+const scanSchema = v.object({ mount: mountSchema, entries: v.array(fileEntrySchema), scanStatus: v.string() })
+
+async function request(path: string, init?: RequestInit) {
+  const response = await workspaceFetch(`/os-workspace${path}`, {
+    ...init, headers: { 'X-OS-Workspace': '1', 'Content-Type': 'application/json' },
+    signal: AbortSignal.timeout(30000)
+  })
+  if (!response.ok) throw new Error(response.status === 409
+    ? '画布已有更新，请保留当前内容后重新打开。'
+    : '本机保存服务不可用，内容仍保留在画布中。')
+  return response
+}
+
+function createLocalWorkspace(store: LocalEditor) {
+  const contentDirty = store.hasUnsavedChanges.bind(store)
+  store.state.autosaveEnabled = true
+  const busy = ref(false)
+  const error = ref('')
+  const status = ref('尚未保存到本机')
+  const documents = ref<StoredDocument[]>([])
+  const history = ref<StoredDocument[]>([])
+  const mounts = ref<StoredMount[]>([])
+  const mountBusy = ref(false)
+  const currentMountId = ref('')
+  const scanBusy = ref(false)
+  const scanStatus = ref('')
+  const stagedRestore = ref(false)
+  let canvasId: string = crypto.randomUUID()
+  let revision = 0
+  let retainedMetadata: v.InferOutput<typeof metadataSchema> | undefined
+  let generation = 0
+  let opening = false
+  let disposed = false
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let scanTimer: ReturnType<typeof setTimeout> | undefined
+  const changes = createDocumentChanges(store)
+  const identity = createLocalIdentity(store)
+  const filter = createLocalFilter(store)
+  const output = createLocalOutput(store, () => ({ canvasId, mountId: currentMountId.value,
+    revision, version: changes.capture() }), save, scanFiles, schedule)
+  const packages = createLocalPackages(() => ({ canvasId, revision, generation }), save, refresh,
+    () => busy.value || scanBusy.value || output.busy.value || mountBusy.value)
+  const viewVersion = ref(0)
+  const savedViewVersion = ref(0)
+  const viewDirty = computed(() => viewVersion.value !== savedViewVersion.value)
+  // Keep exact input across an uncertain response, so retry cannot duplicate a commit.
+  let pending: { body: string; version: number; viewVersion: number } | undefined
+
+  function schedule() {
+    clearTimeout(timer)
+    if (disposed || opening || !store.state.autosaveEnabled || error.value ||
+        (revision === 0 && !contentDirty()) || (!contentDirty() && !viewDirty.value && !stagedRestore.value)) return
+    timer = setTimeout(() => { if (!busy.value && !output.busy.value) void save() }, 1000)
+  }
+  const stopDirtyWatch = watch(() => [contentDirty(), store.state.autosaveEnabled, viewVersion.value], schedule)
+  const stopViewWatch = store.onEditorEvent('viewport:changed', () => { if (!opening) viewVersion.value++ })
+  const stopPageWatch = watch(() => store.state.currentPageId, () => { if (!opening) viewVersion.value++ })
+  const stopGraphWatch = store.onEditorEvent('graph:replaced', () => {
+    if (opening) return
+    generation++; canvasId = crypto.randomUUID(); revision = 0; pending = undefined
+    retainedMetadata = undefined
+    currentMountId.value = ''; scanStatus.value = ''
+    history.value = []; stagedRestore.value = false
+    viewVersion.value = 0; savedViewVersion.value = 0
+    status.value = '尚未保存到本机'; error.value = ''; clearTimeout(timer)
+  })
+
+  async function refresh() {
+    try {
+      const response = await request('/canvases')
+      documents.value = v.parse(v.pipe(v.string(), v.parseJson(), v.array(documentSchema)), await response.text())
+    } catch (cause) { error.value = cause instanceof Error ? cause.message : '无法读取本机画布' }
+  }
+
+  async function refreshMounts() {
+    try {
+      const response = await request('/mounts')
+      mounts.value = v.parse(v.pipe(v.string(), v.parseJson(), v.array(mountSchema)), await response.text())
+    } catch (cause) { error.value = cause instanceof Error ? cause.message : '无法读取目录' }
+  }
+
+  async function scanFiles() { await scanDirectory(false) }
+
+  function canScanDirectory(automatic: boolean) {
+    return Boolean(currentMountId.value) && !scanBusy.value && !busy.value && !opening &&
+      !stagedRestore.value && !(automatic && output.busy.value)
+  }
+
+  async function scanDirectory(automatic: boolean) {
+    if (!canScanDirectory(automatic)) return
+    const target = currentMountId.value, graph = store.graph
+    const isCurrentScan = () => !disposed && store.graph === graph && currentMountId.value === target
+    scanBusy.value = true
+    if (!automatic) scanStatus.value = '正在扫描目录'
+    try {
+      const references = referencedFileMounts(store, target)
+      const results = await Promise.all([...references.keys()].map(async id => {
+        const response = await request(`/mounts/${id}/${automatic ? 'poll' : 'scan'}`, { method: 'POST' })
+        return v.parse(v.pipe(v.string(), v.parseJson(), scanSchema), await response.text())
+      }))
+      if (!isCurrentScan()) return
+      let knownFileAssets = readKnownFileAssets(retainedMetadata?.knownFileAssets)
+      const textIds: string[] = []
+      for (const result of results) {
+        const entries = result.mount.id === target ? result.entries
+          : result.entries.filter(entry => references.get(result.mount.id)?.has(entry.id))
+        attachOutputOrigins(store, entries, canvasId)
+        const reconciled = reconcileFileNodes(store, entries, knownFileAssets, result.mount.availability)
+        knownFileAssets = reconciled.knownFileAssets; textIds.push(...reconciled.textIds)
+      }
+      if (retainedMetadata) retainedMetadata = { ...retainedMetadata, knownFileAssets }
+      if (textIds.length) {
+        await ensureGraphFonts(graph, textIds, store.renderer)
+        if (!isCurrentScan()) return
+        for (const id of textIds) store.runLayoutForNode(id)
+        store.requestRender()
+      }
+      scanStatus.value = results.every(result => result.scanStatus === 'complete') ? '目录与关联文件已更新'
+        : '目录暂不可完整读取，已保留原有内容'
+      schedule()
+    } catch (cause) {
+      if (!isCurrentScan()) return
+      scanStatus.value = '目录刷新失败，原有内容保留'
+      if (!automatic) error.value = cause instanceof Error ? cause.message : '目录刷新失败'
+    } finally { scanBusy.value = false }
+  }
+
+  function scheduleDirectoryScan() {
+    clearTimeout(scanTimer)
+    if (disposed || !currentMountId.value) return
+    scanTimer = setTimeout(() => {
+      void scanDirectory(true).finally(scheduleDirectoryScan)
+    }, 1500)
+  }
+  const stopMountWatch = watch(currentMountId, scheduleDirectoryScan)
+  const replacement = createLocalReplacement(store, () => currentMountId.value, scanFiles)
+  const relink = createLocalRelink(store, scanFiles)
+  const mountRelink = createLocalMountRelink(store, () => currentMountId.value, async () => {
+    await refreshMounts(); await scanFiles()
+  })
+
+  async function openMount(mount: StoredMount) {
+    if (busy.value || mountBusy.value) return
+    if (pending || contentDirty() || viewDirty.value || stagedRestore.value) {
+      error.value = '当前画布有未保存内容，请先保存再打开目录。'; return
+    }
+    mountBusy.value = true; error.value = ''
+    const previousGraph = store.graph
+    try {
+      const response = await request('/canvases')
+      let entries = v.parse(v.pipe(v.string(), v.parseJson(), v.array(documentSchema)), await response.text())
+      let document = entries.find(entry => entry.canvasId === mount.canvasId)
+      if (!document) {
+        if (mount.availability !== 'available') throw new Error('目录当前不可用，尚未创建对应画布。')
+        const graph = new SceneGraph()
+        for (const page of graph.getPages()) setPageBackgrounds(graph, page, [{ type: 'SOLID',
+          color: { ...PAGE_DEFAULT_BACKGROUNDS[store.state.theme ?? 'dark'] }, opacity: 1, visible: true, blendMode: 'NORMAL' }])
+        const pages = graph.getPages().map(page => ({ id: crypto.randomUUID(), name: page.name }))
+        const scene = await exportFigFile(graph)
