+
+
+describe('input and render frame ordering', () => {
+  test('coalesces input and renders all surfaces in the same frame', () => {
+    const raf = createFrameScheduler()
+    try {
+      const { editor, emit } = createEditor()
+      const order: string[] = []
+      createCanvasRenderLoop(editor, () => { order.push('scene') })
+      createCanvasRenderLoop(editor, () => { order.push('overlay') })
+      const scheduler = getEditorFrameScheduler(editor)
+      const input = () => { order.push('input'); emit('viewport:changed') }
+      scheduler.scheduleInput(input)
+      scheduler.scheduleInput(input)
+      raf.flush()
+      expect(order).toEqual(['input', 'scene', 'overlay'])
+      expect(raf.pendingCount).toBe(0)
+    } finally { raf.restore() }
+  })
+
+  test('applies input before an already scheduled render and cancels disposed input', () => {
+    const raf = createFrameScheduler()
+    try {
+      const { editor, emit } = createEditor()
+      const order: string[] = []
+      createCanvasRenderLoop(editor, () => { order.push('render') })
+      emit('repaint:requested')
+      const scheduler = getEditorFrameScheduler(editor)
+      const canceled = () => { order.push('canceled') }
+      scheduler.scheduleInput(canceled)
+      scheduler.cancel(canceled)
+      scheduler.scheduleInput(() => { order.push('input') })
+      raf.flush()
+      expect(order).toEqual(['input', 'render'])
+      expect(raf.pendingCount).toBe(0)
+    } finally { raf.restore() }
+  })
+
+  test('defers work requested during rendering without losing it or spinning', () => {
+    const raf = createFrameScheduler()
+    try {
+      const { editor } = createEditor()
+      const scheduler = getEditorFrameScheduler(editor)
+      const order: string[] = []
+      const input = () => { order.push('input') }
+      scheduler.schedule(() => { order.push('render'); scheduler.scheduleInput(input) })
+      raf.flush()
+      expect(order).toEqual(['render'])
+      expect(raf.pendingCount).toBe(1)
+      raf.flush()
+      expect(order).toEqual(['render', 'input'])
+      expect(raf.pendingCount).toBe(0)
+    } finally { raf.restore() }
+  })
+})
diff --git a/packages/vue/src/shared/input/editor-frame.ts b/packages/vue/src/shared/input/editor-frame.ts
new file mode 100644
--- /dev/null
+++ b/packages/vue/src/shared/input/editor-frame.ts
@@ -0,0 +1,68 @@
+import type { Editor } from '@open-pencil/core/editor'
+
+type FrameCallback = () => void
+
+const schedulers = new WeakMap<Editor, ReturnType<typeof createEditorFrameScheduler>>()
+
+function createEditorFrameScheduler() {
+  const inputs = new Set<FrameCallback>()
+  const renders = new Set<FrameCallback>()
+  let frameId: number | null = null
+  let flushing = false
+
+  function ensureFrame() {
+    if (flushing || frameId !== null || (inputs.size === 0 && renders.size === 0)) return
+    frameId = requestAnimationFrame(flush)
+  }
+
+  function drain(callbacks: Set<FrameCallback>) {
+    // Snapshot so callbacks requeued during this phase wait for the next frame.
+    const pending = [...callbacks]
+    for (const callback of pending) {
+      if (!callbacks.delete(callback)) continue
+      callback()
+    }
+  }
+
+  function flush() {
+    frameId = null
+    flushing = true
+    try {
+      // Apply coalesced input before taking the render snapshot. A viewport change
+      // can therefore request its render in this frame instead of the next one.
+      drain(inputs)
+      drain(renders)
+    } finally {
+      flushing = false
+      ensureFrame()
+    }
+  }
+
+  return {
+    schedule(callback: FrameCallback) {
+      renders.add(callback)
+      ensureFrame()
+    },
+    scheduleInput(callback: FrameCallback) {
+      inputs.add(callback)
+      ensureFrame()
+    },
+    cancel(callback: FrameCallback) {
+      inputs.delete(callback)
+      renders.delete(callback)
+      if (!flushing && inputs.size === 0 && renders.size === 0 && frameId !== null) {
+        cancelAnimationFrame(frameId)
+        frameId = null
+      }
+    }
+  }
+}
+
+export function getEditorFrameScheduler(editor: Editor) {
+  let scheduler = schedulers.get(editor)
+  if (!scheduler) {
+    scheduler = createEditorFrameScheduler()
+    schedulers.set(editor, scheduler)
+  }
+  return scheduler
+}
