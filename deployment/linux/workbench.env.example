# Agent-owned template. systemd EnvironmentFile, never sourced by a shell.
# Install actual file as /etc/workbench/workbench.env, root:root 0600.
# Agent generates the password locally without printing it.
WORKBENCH_PASSWORD=
PUBLIC_ORIGIN=https://workbench.example.invalid
PORT=4310
DATA_DIR=/var/lib/workbench/data
BACKUP_DIR=/srv/workbench-backup-volume/workbench
# Optional: set all three together after private bucket and recovery-key checks.
# OFFSITE_BINARY=/opt/workbench/runtime/rclone-v1.75.1-linux-amd64/rclone
# OFFSITE_CONFIG=/var/lib/workbench-offsite/config/rclone.conf
# OFFSITE_WORK_DIR=/var/lib/workbench-offsite/work
