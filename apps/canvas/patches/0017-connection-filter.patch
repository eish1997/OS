+test('relation visibility follows filtered endpoints without changing authored data', () => {
+  const graph = new SceneGraph(), page = graph.addPage('Relations')
+  const sourceId = '11111111-1111-4111-8111-111111111111'
+  const targetId = '22222222-2222-4222-8222-222222222222'
+  const identity = (value: string) => [{ pluginId: 'os.canvas', key: 'os.canvas/nodeId', value }]
+  const source = graph.createNode('RECTANGLE', page.id, { name: 'Keep source', pluginData: identity(sourceId) })
+  const target = graph.createNode('TEXT', page.id, { name: 'Other target', pluginData: identity(targetId) })
+  const line = graph.createNode('VECTOR', page.id, { name: 'Keep relation', pluginData: [{
+    pluginId: 'os.canvas', key: 'os.canvas/connection', value: JSON.stringify({ version: 1, source: sourceId, target: targetId }) }] })
+  const before = JSON.stringify([...graph.nodes])
+  const filtered = localFilterProjection(graph, page.id, { types: [], associations: [], query: 'Keep' })
+  expect(filtered.shown.has(source.id)).toBe(true)
+  expect(filtered.hidden.has(target.id)).toBe(true)
+  expect(filtered.hidden.has(line.id)).toBe(true)
+  const cleared = localFilterProjection(graph, page.id, { types: [], associations: [], query: '' })
+  expect(cleared.hidden.size).toBe(0)
+  expect(cleared.shown.has(line.id)).toBe(true)
+  expect(JSON.stringify([...graph.nodes])).toBe(before)
+})
