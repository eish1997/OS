+    [{ kind: 'canvas-guide', axis: 'x', position: 99, from: -100, to: 200 }])
+  expect(explicit.correction.x).toBe(1)
+  graph.setViewHiddenNodes(new Set())
+  expect(snap().correction.x).toBe(2)
+})
