+<script setup lang="ts">
+import { computed } from 'vue'
+
+import { useEditorStore } from '@/app/editor/active-store'
+import { useLocalLayout } from '@/app/shell/local-layout'
+import EditorCanvas from '@/components/EditorCanvas.vue'
+import LocalWorkspacePanel from '@/components/editor/LocalWorkspacePanel.vue'
+import LayersPanel from '@/components/LayersPanel.vue'
+import PropertiesPanel from '@/components/PropertiesPanel.vue'
+import Toolbar from '@/components/toolbar/Toolbar.vue'
+import IconButton from '@/components/ui/button/IconButton.vue'
+import AppAlert from '@/components/ui/feedback/AppAlert.vue'
+import AppButton from '@/components/ui/button/AppButton.vue'
+import { osCanvasWorkspace } from '@/theme/os-canvas-workspace'
+
+const store = useEditorStore()
+const { layersOpen, propertiesOpen, error: layoutError, busy: layoutBusy, toggle, retry, reload } = useLocalLayout()
+const editing = computed(() => store.state.showUI && store.state.play === null)
+const styles = osCanvasWorkspace()
+</script>
+
+<template>
+  <div data-slot="os-canvas-workspace" :class="styles.root()">
+    <LocalWorkspacePanel />
+    <!-- The canvas stays mounted and full-size when panels or preview state change. -->
+    <div data-slot="os-canvas-layer" :class="styles.canvas()">
+      <EditorCanvas />
+    </div>
+    <div :class="styles.controls()" aria-label="画布面板">
+      <IconButton
+        label="图层面板"
+        :active="layersOpen"
+        toggle
+        @click="toggle('layers')"
+      >
+        <icon-lucide-panel-left class="size-4" />
+      </IconButton>
+      <IconButton
+        label="属性面板"
+        :active="propertiesOpen"
+        toggle
+        @click="toggle('properties')"
+      >
+        <icon-lucide-panel-right class="size-4" />
+      </IconButton>
+      <IconButton
+        v-if="store.state.play === null"
+        label="预览交互"
+        @click="store.startPlay()"
+      >
+        <icon-lucide-play class="size-4" />
+      </IconButton>
+      <IconButton v-else label="返回编辑" @click="store.stopPlay()">
+        <icon-lucide-square class="size-4" />
+      </IconButton>
+    </div>
+    <AppAlert v-if="layoutError" :class="styles.layoutError()" tone="warning" heading="布局未保存" :description="layoutError">
+      <template #actions>
+        <AppButton :disabled="layoutBusy" @click="retry">重试布局保存</AppButton>
+        <AppButton :disabled="layoutBusy" @click="reload">重新读取布局</AppButton>
+      </template>
+    </AppAlert>
+    <!-- v-show retains panel instances and drafts; none of these dimensions size the canvas. -->
+    <section
+      v-show="editing && layersOpen"
+      data-slot="os-layers-overlay"
+      aria-label="图层"
+      :class="styles.layers()"
+      @pointerdown.stop
+      @wheel.stop
+      @contextmenu.stop
+    >
+      <LayersPanel />
+    </section>
+    <section
+      v-show="editing && propertiesOpen"
+      data-slot="os-properties-overlay"
+      aria-label="属性"
+      :class="styles.properties()"
+      @pointerdown.stop
+      @wheel.stop
+      @contextmenu.stop
+    >
+      <PropertiesPanel />
+    </section>
+    <div v-show="editing" :class="styles.toolbar()">
+      <Toolbar />
+    </div>
+  </div>
+</template>
