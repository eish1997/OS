--- /dev/null
+++ b/src/app/document/local-filter.ts
@@ -0,0 +1,65 @@
+import type { SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+import { fileLinks } from '@/app/document/local-file-nodes'
+
+export type LocalContentType = 'image' | 'video' | 'audio' | 'model' | 'text' | 'document'
+  | 'webpage' | 'folder' | 'shape' | 'line' | 'group' | 'file'
+export type LocalAssociation = 'local' | 'canvas' | 'unavailable'
+export type LocalFilter = { types: LocalContentType[]; associations: LocalAssociation[]; query: string }
+
+function fileType(path: string): LocalContentType {
+  const extension = path.split('.').at(-1)?.toLowerCase() ?? ''
+  if (['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg', 'avif', 'bmp', 'tif', 'tiff'].includes(extension)) return 'image'
+  if (['mp4', 'webm', 'mov', 'mkv', 'avi'].includes(extension)) return 'video'
+  if (['mp3', 'wav', 'flac', 'ogg', 'm4a', 'aac'].includes(extension)) return 'audio'
+  if (['glb', 'gltf', 'obj', 'fbx', 'stl', 'blend'].includes(extension)) return 'model'
+  if (['txt', 'md', 'csv', 'json', 'yaml', 'yml'].includes(extension)) return 'text'
+  if (['pdf', 'doc', 'docx', 'ppt', 'pptx', 'xls', 'xlsx'].includes(extension)) return 'document'
+  if (['html', 'htm', 'url', 'webloc'].includes(extension)) return 'webpage'
+  return 'file'
+}
+
+function isFileCard(graph: SceneGraph, node: SceneNode) {
+  return graph.getChildren(node.id).some(child => child.pluginData.some(
+    item => item.pluginId === 'os.canvas' && item.key === 'os.canvas/fileLabel'))
+}
+
+export function localContentType(graph: SceneGraph, node: SceneNode): LocalContentType {
+  const link = fileLinks(node).at(0)
+  if (link && isFileCard(graph, node)) return link.kind === 'directory' ? 'folder' : fileType(link.path)
+  if (node.type === 'TEXT') return 'text'
+  if (node.type === 'LINE') return 'line'
+  if (['GROUP', 'FRAME', 'SECTION', 'COMPONENT', 'COMPONENT_SET', 'INSTANCE'].includes(node.type)) return 'group'
+  if (node.fills.some(fill => fill.type === 'IMAGE')) return 'image'
+  return 'shape'
+}
+
+function matches(graph: SceneGraph, node: SceneNode, filter: LocalFilter) {
+  const links = fileLinks(node)
+  const associations: LocalAssociation[] = links.length ? [] : ['canvas']
+  if (links.some(link => link.availability === 'available')) associations.push('local')
+  if (links.some(link => link.availability !== 'available')) associations.push('unavailable')
+  if (filter.types.length && !filter.types.includes(localContentType(graph, node))) return false
+  if (filter.associations.length && !filter.associations.some(value => associations.includes(value))) return false
+  const query = filter.query.trim().toLocaleLowerCase()
+  return !query || [node.name, ...links.map(link => link.path)].some(value => value.toLocaleLowerCase().includes(query))
+}
+
+/** A compound object is one display unit. Its authored content is never split or mutated. */
+export function localFilterProjection(graph: SceneGraph, pageId: string, filter: LocalFilter) {
+  const roots = graph.getChildren(pageId)
+  const shown = new Set<string>(), hidden = new Set<string>()
+  const seen = new Set<string>()
+  function matchesSubtree(node: SceneNode): boolean {
+    if (seen.has(node.id)) return false
+    seen.add(node.id)
+    if (matches(graph, node, filter)) return true
+    // Generated filename labels are presentation, not independent text assets.
+    if (isFileCard(graph, node)) return false
+    return graph.getChildren(node.id).some(matchesSubtree)
+  }
+  for (const root of roots) {
+    if (matchesSubtree(root)) shown.add(root.id)
+    else hidden.add(root.id)
+  }
+  return { shown, hidden, total: roots.length }
+}
diff --git a/src/app/document/local-identity.ts b/src/app/document/local-identity.ts
