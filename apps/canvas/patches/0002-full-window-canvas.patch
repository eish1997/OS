new file mode 100644
index 0000000..46f1a06
--- /dev/null
+++ b/tests/app/document/local-filter.test.ts
@@ -0,0 +1,41 @@
+import { expect, test } from 'bun:test'
+import { SceneGraph } from '@open-pencil/scene-graph'
+import { localFilterProjection } from '@/app/document/local-filter'
+
+test('compound filtering matches all dimensions on one node and preserves the entire authored tree', () => {
+  const graph = new SceneGraph(), page = graph.addPage('Assets')
+  const frame = graph.createNode('FRAME', page.id, { x: 120, y: 90, name: 'Design' })
+  graph.createNode('TEXT', frame.id, { name: 'Notes', text: 'work in progress' })
+  const rectangle = graph.createNode('RECTANGLE', page.id)
+  const before = JSON.stringify([...graph.nodes])
+  const filtered = localFilterProjection(graph, page.id, { types: ['text'], associations: ['canvas'], query: 'notes' })
+  expect([...filtered.shown]).toEqual([frame.id])
+  expect([...filtered.hidden]).toEqual([rectangle.id])
+  expect(JSON.stringify([...graph.nodes])).toBe(before)
+  const cleared = localFilterProjection(graph, page.id, { types: [], associations: [], query: '' })
+  expect(cleared.hidden.size).toBe(0)
+  expect(cleared.total).toBe(2)
+  expect(JSON.stringify([...graph.nodes])).toBe(before)
+})
+
+test('file card type comes from the asset and generated labels cannot match as canvas text', () => {
+  const graph = new SceneGraph(), page = graph.addPage('Assets')
+  const card = graph.createNode('FRAME', page.id, { name: 'Photo', pluginData: [{ pluginId: 'os.canvas',
+    key: 'os.canvas/fileLink', value: JSON.stringify({ id: 'asset', mountId: 'mount', path: '照片.PNG',
+      kind: 'file', size: '120', revision: 1, availability: 'available' }) }] })
+  graph.createNode('TEXT', card.id, { name: '照片.PNG', pluginData: [{ pluginId: 'os.canvas',
+    key: 'os.canvas/fileLabel', value: '1' }] })
+  expect(localFilterProjection(graph, page.id, { types: ['image', 'audio'], associations: ['local'], query: '.png' }).shown.has(card.id)).toBe(true)
+  expect(localFilterProjection(graph, page.id, { types: ['text'], associations: [], query: '' }).hidden.has(card.id)).toBe(true)
+  expect(localFilterProjection(graph, page.id, { types: [], associations: ['canvas'], query: '' }).hidden.has(card.id)).toBe(true)
+})
+
+test('missing association remains local metadata and does not become unassociated canvas content', () => {
+  const graph = new SceneGraph(), page = graph.addPage('Assets')
+  const node = graph.createNode('TEXT', page.id, { name: 'Result', pluginData: [{ pluginId: 'os.canvas',
+    key: 'os.canvas/fileLink', value: JSON.stringify({ id: 'asset', mountId: 'mount', path: '成果.txt',
+      kind: 'file', size: '120', revision: 2, availability: 'missing' }) }] })
+  expect(localFilterProjection(graph, page.id, { types: ['text'], associations: ['unavailable', 'local'], query: '成果' }).shown.has(node.id)).toBe(true)
+  expect(localFilterProjection(graph, page.id, { types: [], associations: ['canvas'], query: '' }).hidden.has(node.id)).toBe(true)
+  expect(localFilterProjection(graph, page.id, { types: [], associations: ['local'], query: '' }).hidden.has(node.id)).toBe(true)
+})
