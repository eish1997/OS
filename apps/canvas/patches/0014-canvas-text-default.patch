+import type { Editor } from '@open-pencil/core/editor'
+
+/** Defaults for newly drawn bare-canvas text, without recoloring artwork. */
+export function installCanvasDrawingDefaults(store: Editor): void {
+  const createShape = store.createShape
+  store.createShape = (...args) => {
+    const id = createShape(...args)
+    const node = store.graph.getNode(id)
+    if (node?.type === 'TEXT' && node.parentId === store.state.currentPageId) {
+      store.graph.updateNode(id, { fills: [{ type: 'SOLID',
+        color: { r: 238 / 255, g: 238 / 255, b: 238 / 255, a: 1 }, opacity: 1, visible: true }] })
+    }
+    return id
+  }
+}
