diff --git a/src/app/runtime/workbench-bridge.ts b/src/app/runtime/workbench-bridge.ts
--- /dev/null
+++ b/src/app/runtime/workbench-bridge.ts
@@ -0,0 +1,101 @@
+import { useIntervalFn } from '@vueuse/core'
+import { onScopeDispose, watch } from 'vue'
+import { osEmbedded } from './embedding'
+import { getLocalWorkspace } from '@/app/document/local-workspace'
+import { CanvasBridgeEndpoint, CanvasBridgeError, type CanvasContext, type CanvasEnvelope } from '#workbench/canvas-bridge'
+
+const capabilities = ['save-barrier', 'document-state', 'interaction', 'theme', 'open-context']
+
+export function useWorkbenchBridge(store: Parameters<typeof getLocalWorkspace>[0]) {
+  if (!osEmbedded) return
+  const workspace = getLocalWorkspace(store)
+  const instanceId = crypto.randomUUID()
+  let context: CanvasContext = { contextEpoch: 0, projectId: null, canvasId: workspace.bridgeSnapshot().canvasId }
+  let initialized = false, modalBlocked = false, switchBlocked = false, disposed = false
+  const applyInteraction = () => { document.body.inert = !initialized || modalBlocked || switchBlocked }
+  const publish = () => {
+    if (!initialized || disposed) return
+    const { canvasId: _canvasId, ...state } = workspace.bridgeSnapshot()
+    endpoint.notify('DOCUMENT_STATE', state)
+  }
+  const endpoint = new CanvasBridgeEndpoint({ instanceId, origin: location.origin,
+    peer: () => window.parent, context: () => context,
+    send: (message, origin) => window.parent.postMessage(message, origin),
+    onCommand: async message => {
+      switch (message.type) {
+        case 'INIT': {
+          const requested = message.payload.capabilities as string[]
+          if (!capabilities.every(capability => requested.includes(capability))) throw new CanvasBridgeError('incompatible-capabilities', '工作台与画板版本不兼容')
+          initialized = true; ready.pause(); applyInteraction()
+          return { capabilities, document: workspace.bridgeSnapshot() }
+        }
+        case 'SAVE': return { document: await workspace.saveForBridge() }
+        case 'PREPARE_SWITCH':
+          switchBlocked = true; workspace.pauseForBridge(true); applyInteraction()
+          return { document: await workspace.saveForBridge() }
+        case 'OPEN_CONTEXT': {
+          if (!switchBlocked) throw new CanvasBridgeError('switch-not-prepared', '切换前必须确认保存')
+          const target = message.payload.target as CanvasContext
+          if (target.contextEpoch <= context.contextEpoch || !target.canvasId) throw new CanvasBridgeError('invalid-context', '画板上下文无效')
+          const state = await workspace.openFromBridge(target.canvasId)
+          context = { ...target }
+          return { document: state, context }
+        }
+        case 'SET_INTERACTION':
+          modalBlocked = message.payload.blocked as boolean
+          if (message.payload.releaseSwitch) { switchBlocked = false; workspace.pauseForBridge(false) }
+          applyInteraction(); return {}
+        case 'THEME': {
+          const colors = message.payload.colors as Record<string, string>
+          for (const [key, value] of Object.entries(colors)) document.documentElement.style.setProperty(`--wb-${key}`, value)
+          const tokens: Record<string, string> = { canvas: 'background', panel: 'surface', 'panel-secondary': 'surface',
+            'panel-field': 'surface', input: 'surface', surface: 'foreground', muted: 'muted', border: 'border', accent: 'accent' }
+          for (const [token, key] of Object.entries(tokens)) document.documentElement.style.setProperty(`--color-${token}`, colors[key])
+          document.documentElement.style.setProperty('--wb-line-width', `${String(message.payload.lineWidth)}px`)
+          return {}
+        }
+        default: throw new CanvasBridgeError('unsupported-command', '不支持的画板命令')
+      }
+    }
+  })
+  const receive = (event: MessageEvent<CanvasEnvelope>) => { endpoint.receive(event) }
+  const pointer = (event: PointerEvent) => {
+    if (!initialized || modalBlocked || switchBlocked) return
+    endpoint.notify('INTERACTION_STARTED', { kind: 'pointer' })
+    if (event.target instanceof HTMLCanvasElement && event.button <= 1) {
+      try { event.target.setPointerCapture(event.pointerId) } catch (error) { if (!(error instanceof DOMException && error.name === 'NotFoundError')) throw error }
+    }
+  }
+  const keyboard = (event: KeyboardEvent) => {
+    if (!initialized || modalBlocked || switchBlocked) return
+    endpoint.notify('INTERACTION_STARTED', { kind: 'keyboard' })
+    if (!event.isComposing && (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 's') {
+      event.preventDefault(); event.stopImmediatePropagation()
+      void workspace.saveForBridge().catch(() => { publish() })
+    }
+  }
+  const focus = () => { if (initialized) endpoint.notify('FOCUS_CHANGED', { focused: document.hasFocus() }) }
+  workspace.setOpenRequest(canvasId => { if (initialized) endpoint.notify('REQUEST_OPEN', { canvasId }) })
+  const stop = watch(() => workspace.bridgeSnapshot(), publish, { deep: true })
+  window.addEventListener('message', receive)
+  document.addEventListener('pointerdown', pointer, true)
+  document.addEventListener('keydown', keyboard, true)
+  window.addEventListener('focus', focus); window.addEventListener('blur', focus)
+  applyInteraction()
+  const style = document.createElement('style')
+  style.textContent = ['.border{border-width:', '.border-t{border-top-width:', '.border-b{border-bottom-width:', '.border-l{border-left-width:', '.border-r{border-right-width:']
+    .map(rule => `[data-slot="os-canvas-workspace"] ${rule}var(--wb-line-width,1px)}`).join('\n')
+  document.head.append(style)
+  const announce = () => { if (!initialized) endpoint.notify('READY', { capabilities }) }
+  const ready = useIntervalFn(announce, 250, { immediateCallback: true })
+  onScopeDispose(() => {
+    disposed = true; ready.pause(); stop(); endpoint.dispose()
+    style.remove()
+    workspace.setOpenRequest(); workspace.pauseForBridge(false)
+    window.removeEventListener('message', receive)
+    document.removeEventListener('pointerdown', pointer, true)
+    document.removeEventListener('keydown', keyboard, true)
+    window.removeEventListener('focus', focus); window.removeEventListener('blur', focus)
+    document.body.inert = false
+  })
+}
