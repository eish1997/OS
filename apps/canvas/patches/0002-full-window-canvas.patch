@@ -0,0 +1,85 @@
+import { workspaceFetch } from '@/app/document/workspace-fetch'
+import * as v from 'valibot'
+import { computed, ref } from 'vue'
+
+const layoutSchema = v.looseObject({ formatVersion: v.literal(1),
+  panels: v.looseObject({ layers: v.boolean(), properties: v.boolean() }) })
+const savedSchema = v.object({ revision: v.number() })
+const readSchema = v.object({ revision: v.number(), layout: layoutSchema })
+type Layout = v.InferOutput<typeof layoutSchema>
+const layout = ref<Layout>({ formatVersion: 1, panels: { layers: true, properties: true } })
+const error = ref('')
+const busy = ref(false)
+let revision = 0
+let loaded = false
+let started = false
+let edit = 0
+let pending: { edit: number; body: string } | undefined
+
+async function request(init?: RequestInit) {
+  const response = await workspaceFetch('/os-workspace/layout', { ...init,
+    headers: { 'X-OS-Workspace': '1', 'Content-Type': 'application/json' }, signal: AbortSignal.timeout(15000) })
+  if (!response.ok) throw new Error(response.status === 409
+    ? '其他窗口已修改布局，请重新读取后再调整。'
+    : '布局尚未保存，画布作品不受影响。')
+  return response.text()
+}
+
+async function load(preserveEdits = false) {
+  if (busy.value) return
+  busy.value = true; error.value = ''
+  const before = edit
+  try {
+    const saved = v.parse(v.pipe(v.string(), v.parseJson(), readSchema), await request())
+    revision = saved.revision; loaded = true; pending = undefined
+    if (before === edit && !preserveEdits) layout.value = saved.layout
+    else layout.value = { ...saved.layout, panels: { ...saved.layout.panels, ...layout.value.panels } }
+  } catch (cause) { error.value = cause instanceof Error ? cause.message : '布局读取失败' }
+  finally { busy.value = false }
+  if (loaded && (before !== edit || preserveEdits)) await save()
+}
+
+async function save() {
+  if (busy.value || !loaded) return
+  busy.value = true; error.value = ''
+  try {
+    let committed: number
+    do {
+      pending ??= { edit, body: JSON.stringify({ operationId: crypto.randomUUID(), expectedRevision: revision, layout: layout.value }) }
+      const saved = v.parse(v.pipe(v.string(), v.parseJson(), savedSchema), await request({ method: 'POST', body: pending.body }))
+      revision = saved.revision
+      committed = pending.edit
+      pending = undefined
+    } while (committed !== edit)
+  } catch (cause) { error.value = cause instanceof Error ? cause.message : '布局保存失败' }
+  finally { busy.value = false }
+}
+
+async function applyPreset(value: unknown) {
+  if (busy.value || pending || error.value) return false
+  const parsed = v.safeParse(layoutSchema, value)
+  if (!parsed.success) { error.value = '包内布局格式不受支持，当前布局已保留。'; return false }
+  const before = edit
+  let applied = false
+  busy.value = true
+  try {
+    const saved = v.parse(v.pipe(v.string(), v.parseJson(), readSchema), await request())
+    revision = saved.revision; loaded = true
+    if (before === edit) { layout.value = parsed.output; edit++; applied = true }
+  } catch (cause) { error.value = cause instanceof Error ? cause.message : '布局读取失败' }
+  finally { busy.value = false }
+  if (!error.value && before !== edit) await save()
+  return applied && !error.value
+}
+
+export function useLocalLayout() {
+  if (!started) { started = true; void load() }
+  function toggle(panel: 'layers' | 'properties') {
+    layout.value = { ...layout.value, panels: { ...layout.value.panels, [panel]: !layout.value.panels[panel] } }
+    edit++
+    if (!error.value) void save()
+  }
+  return { layersOpen: computed(() => layout.value.panels.layers),
+    propertiesOpen: computed(() => layout.value.panels.properties), error, busy, toggle, applyPreset,
+    reload: () => load(), retry: () => loaded ? save() : load(true) }
+}
