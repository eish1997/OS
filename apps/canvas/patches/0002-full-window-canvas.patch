diff --git a/desktop/src/os_workspace.rs b/desktop/src/os_workspace.rs
new file mode 100644
index 0000000..84c935f
--- /dev/null
+++ b/desktop/src/os_workspace.rs
@@ -0,0 +1,152 @@
+use std::{
+    io::{BufRead, BufReader, Read, Write},
+    path::PathBuf,
+    process::{Child, ChildStdin, Command, Stdio},
+    sync::{mpsc, Arc, Mutex},
+    time::Duration,
+};
+use tauri::{http::{Request, Response}, Manager};
+
+const LIMIT: usize = 350 * 1024 * 1024;
+#[cfg(windows)]
+const ORIGIN: &str = "http://tauri.localhost";
+#[cfg(not(windows))]
+const ORIGIN: &str = "tauri://localhost";
+
+struct OwnedChild { child: Child, input: Option<ChildStdin> }
+impl Drop for OwnedChild {
+    fn drop(&mut self) {
+        self.input.take();
+        for _ in 0..20 {
+            if matches!(self.child.try_wait(), Ok(Some(_))) { return; }
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+pub struct Workspace {
+    _child: Mutex<OwnedChild>,
+    url: String,
+    token: String,
+    client: reqwest::Client,
+}
+
+pub fn setup(app: &tauri::App) -> Result<(), Box<dyn std::error::Error>> {
+    let resources = if cfg!(debug_assertions) {
+        std::env::var_os("OS_CANVAS_RESOURCE_DIR").map(PathBuf::from)
+    } else {
+        Some(app.path().resource_dir()?.join("canvas"))
+    };
+    let Some(resources) = resources else { return Ok(()); };
+    let directory = if cfg!(debug_assertions) {
+        std::env::var_os("OS_CANVAS_DATA_DIR").map(PathBuf::from)
+            .ok_or("Desktop development requires an independent OS_CANVAS_DATA_DIR")?
+    } else { app.path().app_local_data_dir()?.join("canvas") };
+    let mut secret = [0u8; 32];
+    getrandom::fill(&mut secret).map_err(|_| "Cannot generate service credentials")?;
+    let token = secret.iter().map(|byte| format!("{byte:02x}")).collect::<String>();
+    // Tauri canonicalizes Windows paths to \\?\ form. Node's main-script resolver
+    // rejects that form; a file URL preserves Unicode/UNC paths without shell code.
+    let service_url = url::Url::from_file_path(resources.join("service/desktop-service.mjs"))
+        .map_err(|_| "Invalid workspace service file path")?;
+    let mut command = Command::new(resources.join("runtime/node.exe"));
+    command.args(["--input-type=module", "--eval", "import(process.argv[1])", service_url.as_str()])
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped());
+    // Prevent inherited Node options from injecting code into this trusted process.
+    command.env_remove("NODE_OPTIONS").env_remove("NODE_PATH");
+    #[cfg(windows)] {
+        use std::os::windows::process::CommandExt;
+        command.creation_flags(0x08000000);
+    }
+    let mut child = command.spawn()?;
+    let stderr = child.stderr.take().ok_or("Service stderr unavailable")?;
+    let (error_sender, error_receiver) = mpsc::channel();
+    std::thread::spawn(move || {
+        let mut text = String::new();
+        let _ = stderr.take(8192).read_to_string(&mut text);
+        let _ = error_sender.send(text);
+    });
+    let stdout = child.stdout.take().ok_or("Service stdout unavailable")?;
+    let input = child.stdin.take();
+    let mut owned = OwnedChild { child, input };
+    let config = serde_json::json!({ "directory": directory, "token": token, "origin": ORIGIN });
+    writeln!(owned.input.as_mut().ok_or("Service stdin unavailable")?, "{config}")?;
+    let (sender, receiver) = mpsc::channel();
+    std::thread::spawn(move || {
+        let mut reader = BufReader::new(stdout);
+        let mut line = Vec::new();
+        // Bounded readiness message, never read arbitrary service output into memory.
+        let result = std::io::Read::take(&mut reader, 4096).read_until(b'\n', &mut line)
+            .map(|_| line);
+        let _ = sender.send(result);
+    });
+    let line = receiver.recv_timeout(Duration::from_secs(15))??;
+    if line.is_empty() {
+        let details = error_receiver.recv_timeout(Duration::from_secs(1)).unwrap_or_default();
+        return Err(format!("Workspace service exited before ready: {}", details.replace(&token, "[redacted]")).into());
+    }
+    let ready: serde_json::Value = serde_json::from_slice(&line)?;
+    if ready["type"] != "ready" || ready["protocolVersion"] != 1 { return Err("Invalid service readiness".into()); }
+    let url = ready["url"].as_str().ok_or("Missing service URL")?;
+    let parsed = url::Url::parse(url)?;
+    if parsed.scheme() != "http" || parsed.host_str() != Some("127.0.0.1") ||
+        parsed.port().is_none() || parsed.path() != "/" || parsed.query().is_some() ||
+        parsed.fragment().is_some() || !parsed.username().is_empty() || parsed.password().is_some() {
+        return Err("Invalid service address".into());
+    }
+    let client = reqwest::Client::builder().no_proxy()
+        .redirect(reqwest::redirect::Policy::none()).timeout(Duration::from_secs(60)).build()?;
+    app.manage(Arc::new(Workspace { _child: Mutex::new(owned), url: url.to_string(), token, client }));
+    Ok(())
+}
+
+fn response(status: u16, body: Vec<u8>, content_type: &str) -> Response<Vec<u8>> {
+    Response::builder().status(status)
+        .header("Access-Control-Allow-Origin", ORIGIN)
+        .header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
+        .header("Access-Control-Allow-Headers", "Content-Type, X-OS-Workspace")
+        .header("Cache-Control", "no-store").header("Content-Type", content_type)
+        .body(body).expect("fixed response headers")
+}
+
+async fn forward(workspace: Arc<Workspace>, request: Request<Vec<u8>>) -> Result<Response<Vec<u8>>, reqwest::Error> {
+    let path = request.uri().path_and_query().map(|value| value.as_str()).unwrap_or("/");
+    let suffix = &path["/os-workspace".len()..];
+    let content_type = request.headers().get("Content-Type").and_then(|v| v.to_str().ok()).unwrap_or("application/json").to_string();
+    let mut upstream = workspace.client.request(request.method().clone(), format!("{}{suffix}", workspace.url))
+        .bearer_auth(&workspace.token).header("Origin", ORIGIN).header("Content-Type", content_type)
+        .body(request.into_body()).send().await?;
+    let status = upstream.status().as_u16();
+    let mime = upstream.headers().get("Content-Type").and_then(|v| v.to_str().ok()).unwrap_or("application/json").to_string();
+    let mut bytes = Vec::new();
+    while let Some(chunk) = upstream.chunk().await? {
+        if bytes.len().saturating_add(chunk.len()) > LIMIT { return Ok(response(413, Vec::new(), "text/plain")); }
+        bytes.extend_from_slice(&chunk);
+    }
+    Ok(response(status, bytes, &mime))
+}
+
+pub fn protocol(context: tauri::UriSchemeContext<'_, tauri::Wry>, request: Request<Vec<u8>>, responder: tauri::UriSchemeResponder) {
+    let origin = request.headers().get("Origin").and_then(|value| value.to_str().ok());
+    let path = request.uri().path();
+    if context.webview_label() != "main" || origin != Some(ORIGIN) ||
+        !(path == "/os-workspace" || path.starts_with("/os-workspace/")) {
+        responder.respond(response(403, Vec::new(), "text/plain")); return;
+    }
+    if request.method() == "OPTIONS" { responder.respond(response(204, Vec::new(), "text/plain")); return; }
+    if !matches!(request.method().as_str(), "GET" | "POST") ||
+        request.headers().get("X-OS-Workspace").and_then(|v| v.to_str().ok()) != Some("1") {
+        responder.respond(response(403, Vec::new(), "text/plain")); return;
+    }
+    if request.body().len() > LIMIT { responder.respond(response(413, Vec::new(), "text/plain")); return; }
+    let Some(state) = context.app_handle().try_state::<Arc<Workspace>>() else {
+        responder.respond(response(503, Vec::new(), "text/plain")); return;
+    };
+    let workspace = Arc::clone(state.inner());
+    tauri::async_runtime::spawn(async move {
+        let result = forward(workspace, request).await.unwrap_or_else(|_| response(503, Vec::new(), "text/plain"));
+        responder.respond(result);
+    });
+}
