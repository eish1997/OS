@@ -0,0 +1,68 @@
+import { workspaceFetch } from '@/app/document/workspace-fetch'
+import { ref, watch } from 'vue'
+import * as v from 'valibot'
+import type { Editor } from '@open-pencil/core/editor'
+import { fileEntrySchema, fileLink, relinkFileNode, selectedFileNode } from '@/app/document/local-file-nodes'
+import { ensureGraphFonts } from '@/app/editor/fonts'
+
+const targetSchema = v.object({ token: v.string(), path: v.string(), size: v.string() })
+
+export function createLocalRelink(editor: Editor, refresh: () => Promise<void>) {
+  const path = ref('')
+  const preview = ref<v.InferOutput<typeof targetSchema>>()
+  const busy = ref(false)
+  const error = ref('')
+  let generation = 0
+  let disposed = false
+  let nodeId = ''
+  const isCurrent = (value: number) => !disposed && generation === value
+  function cancel() { generation++; preview.value = undefined; error.value = ''; nodeId = '' }
+  const stopSelection = editor.onEditorEvent('selection:changed', cancel)
+  const stopGraph = editor.onEditorEvent('graph:replaced', cancel)
+  const stopPath = watch(path, cancel)
+  async function call(action: string, body: { path: string } | { token: string }) {
+    const response = await workspaceFetch(`/os-workspace/file-targets/${action}`, { method: 'POST',
+      headers: { 'X-OS-Workspace': '1', 'Content-Type': 'application/json' },
+      body: JSON.stringify(body), signal: AbortSignal.timeout(30000) })
+    if (!response.ok) throw new Error(response.status === 409
+      ? '目标已变化或需要先确认原件替换，请重新检查。'
+      : '无法读取目标，请选择可访问的本地普通文件。')
+    return response
+  }
+  async function prepare() {
+    if (busy.value) return
+    cancel()
+    const node = selectedFileNode(editor)
+    if (!node || !path.value.trim()) { error.value = '请选中原节点并填写目标文件的完整路径。'; return }
+    if (fileLink(node)?.kind !== 'file') { error.value = '此入口用于重新关联普通文件。'; return }
+    nodeId = node.id
+    const current = generation
+    busy.value = true
+    try {
+      const response = await call('preview', { path: path.value.trim() })
+      const result = v.parse(v.pipe(v.string(), v.parseJson(), targetSchema), await response.text())
+      if (isCurrent(current)) preview.value = result
+    } catch (cause) {
+      if (isCurrent(current)) error.value = cause instanceof Error ? cause.message : '无法预览目标'
+    } finally { busy.value = false }
+  }
+  async function confirm() {
+    const candidate = preview.value
+    if (!candidate || busy.value) return
+    const current = generation
+    busy.value = true; error.value = ''
+    try {
+      const response = await call('confirm', { token: candidate.token })
+      const entry = v.parse(v.pipe(v.string(), v.parseJson(), fileEntrySchema), await response.text())
+      if (!isCurrent(current)) return
+      const textIds = relinkFileNode(editor, nodeId, entry)
+      preview.value = undefined
+      await ensureGraphFonts(editor.graph, textIds, editor.renderer)
+      if (isCurrent(current)) { editor.requestRender(); await refresh() }
+    } catch (cause) {
+      if (isCurrent(current)) error.value = cause instanceof Error ? cause.message : '无法关联目标'
+    } finally { busy.value = false }
+  }
+  function dispose() { disposed = true; cancel(); stopSelection(); stopGraph(); stopPath() }
+  return { path, preview, busy, error, prepare, confirm, cancel, dispose }
+}
