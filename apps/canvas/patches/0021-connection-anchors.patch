diff --git a/src/app/document/local-connection-edit.ts b/src/app/document/local-connection-edit.ts
new file mode 100644
--- /dev/null
+++ b/src/app/document/local-connection-edit.ts
@@ -0,0 +1,33 @@
+import { computed } from 'vue'
+import type { Editor } from '@open-pencil/core/editor'
+import { key, pluginId, relation } from './local-connection-data'
+import type { AnchorSide } from './local-connection-data'
+
+export function useConnectionEdit(editor: Editor) {
+  const selected = computed(() => {
+    void editor.state.sceneVersion
+    if (editor.state.selectedIds.size !== 1) return undefined
+    const node = editor.graph.getNode([...editor.state.selectedIds][0])
+    const link = node && relation(node)
+    return node && link ? { id: node.id, locked: node.locked, link } : undefined
+  })
+  function setAnchor(endpoint: 'source' | 'target', side: AnchorSide) {
+    const current = selected.value
+    if (!current || current.locked) return
+    const node = editor.graph.getNode(current.id)
+    if (!node) return
+    const field = endpoint === 'source' ? 'sourceAnchor' : 'targetAnchor'
+    if ((current.link[field] ?? (endpoint === 'source' ? 'right' : 'left')) === side) return
+    const before = node.pluginData
+    const after = before.map(item => item.pluginId === pluginId && item.key === key
+      ? { ...item, value: JSON.stringify({ ...current.link, [field]: side }) } : item)
+    const apply = (data: typeof before) => {
+      if (!editor.graph.getNode(current.id)) return
+      editor.graph.updateNode(current.id, { pluginData: data })
+      editor.requestRender()
+    }
+    apply(after)
+    editor.undo.push({ label: 'Change connection anchor', forward: () => apply(after), inverse: () => apply(before) })
+  }
+  return { selected, setAnchor }
+}
