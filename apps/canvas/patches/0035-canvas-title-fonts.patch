diff --git a/src/app/document/local-title-fonts.ts b/src/app/document/local-title-fonts.ts
new file mode 100644
--- /dev/null
+++ b/src/app/document/local-title-fonts.ts
@@ -0,0 +1,54 @@
+import { onScopeDispose, ref } from 'vue'
+import { uniq } from 'es-toolkit'
+import { fontManager } from '@open-pencil/core/text'
+import type { Editor } from '@open-pencil/core/editor'
+
+/** Canvas labels are not TEXT nodes, so document-body font discovery cannot see them. */
+export function useLocalTitleFonts(editor: Editor) {
+  const titleFontsLoading = ref(false), titleFontsFailed = ref(false)
+  let disposed = false, queued = false, running = false, attempted = ''
+  let graph = editor.graph
+  const active = () => !disposed
+  function names() {
+    return uniq([...editor.graph.nodes.values()]
+      .filter(node => ['FRAME', 'SECTION', 'COMPONENT', 'COMPONENT_SET', 'INSTANCE'].includes(node.type))
+      .map(node => node.name)).sort().join('\n')
+  }
+  function schedule() {
+    if (queued || disposed) return
+    queued = true
+    queueMicrotask(() => { queued = false; void prepare() })
+  }
+  async function prepare() {
+    if (disposed || running) return
+    if (graph !== editor.graph) { graph = editor.graph; attempted = ''; titleFontsFailed.value = false }
+    const text = names(), target = graph
+    if (!text || text === attempted) return
+    attempted = text
+    const scripts: ('cjk' | 'arabic')[] = []
+    if (/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/u.test(text)) scripts.push('cjk')
+    if (/\p{Script=Arabic}/u.test(text)) scripts.push('arabic')
+    if (!scripts.length) { titleFontsFailed.value = false; return }
+    running = true; titleFontsLoading.value = true; titleFontsFailed.value = false
+    const current = () => !disposed && editor.graph === target && names() === text
+    try {
+      const loaded = await fontManager.ensureFallbackPack(scripts, text)
+      if (scripts.some(script => !loaded[script]?.length)) throw new Error('Title font unavailable')
+      if (current()) editor.requestRender()
+    } catch {
+      if (current()) titleFontsFailed.value = true
+    } finally {
+      running = false
+      if (active()) { titleFontsLoading.value = false; schedule() }
+    }
+  }
+  const stops = [
+    editor.onEditorEvent('node:created', schedule),
+    editor.onEditorEvent('node:deleted', schedule),
+    editor.onEditorEvent('node:updated', (_id, changes) => { if ('name' in changes) schedule() }),
+    editor.onEditorEvent('graph:replaced', schedule)
+  ]
+  onScopeDispose(() => { disposed = true; for (const stop of stops) stop() })
+  schedule()
+  return { titleFontsLoading, titleFontsFailed, retryTitleFonts: () => { attempted = ''; schedule() } }
+}
