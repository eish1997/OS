+++ b/src/app/document/local-note.ts
@@ -0,0 +1,28 @@
+import type { Editor } from '@open-pencil/core/editor'
+
+/** Notes are editable frame/text artwork, using the same graph and history as other objects. */
+export function createLocalNote(editor: Editor, viewportWidth: number, viewportHeight: number) {
+  editor.commitTextEdit()
+  editor.flushNudge()
+  const { zoom, panX, panY } = editor.state
+  const x = (viewportWidth / 2 - panX) / zoom - 120
+  const y = (viewportHeight / 2 - panY) / zoom - 100
+  const textId = editor.undo.runBatch('Create note', () => {
+    const frame = editor.createShape('FRAME', x, y, 240, 200, undefined, '便签')
+    editor.graph.updateNode(frame, {
+      clipsContent: false,
+      fills: [{ type: 'SOLID', color: { r: 238 / 255, g: 238 / 255, b: 234 / 255, a: 1 }, opacity: 1, visible: true }],
+      pluginData: [{ pluginId: 'os.canvas', key: 'os.canvas/note', value: '1' }]
+    })
+    const text = editor.createShape('TEXT', 16, 16, 208, 32, frame, '便签正文')
+    editor.graph.updateNode(text, {
+      fontSize: 18, textAutoResize: 'HEIGHT', horizontalConstraint: 'STRETCH',
+      fills: [{ type: 'SOLID', color: { r: 36 / 255, g: 35 / 255, b: 31 / 255, a: 1 }, opacity: 1, visible: true }]
+    })
+    return text
+  })
+  editor.setTool('SELECT')
+  editor.select([textId])
+  editor.startTextEditing(textId)
+  editor.requestRender()
+}
