{
	admin off
	persist_config off
	skip_install_trust
	auto_https disable_redirects
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 30s
			write_idle 0
			idle 5m
		}
	}
}

# Deployment-owned values; never interpolate user chat into this file.
# TLS_MODE is empty for public automatic certificates; isolated probe uses
# "tls internal" without installing that CA into any system trust store.
{$WORKBENCH_SITE} {
	bind {$PROXY_BIND:127.0.0.1}
	{$TLS_MODE}
	request_body {
		max_size 10485760
	}
	# Caddy flushes text/event-stream automatically. A negative flush_interval
	# would change cancellation on disconnect, so keep its streaming defaults.
	reverse_proxy 127.0.0.1:{$WORKBENCH_PORT:4310} {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
	header -Server
}
