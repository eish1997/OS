@@ -0,0 +1,10 @@
+import { convertFileSrc } from '@tauri-apps/api/core'
+import { isTauri } from '@/app/tauri/env'
+
+// The native protocol keeps the service address and token out of the renderer.
+// Browser development continues to use the authenticated Vite host proxy.
+export function workspaceFetch(path: string, init?: RequestInit): Promise<Response> {
+  if (!path.startsWith('/os-workspace/')) throw new Error('Invalid workspace request path')
+  const url = isTauri() ? new URL(path, convertFileSrc('', 'osworkspace')).href : path
+  return fetch(url, init)
+}
