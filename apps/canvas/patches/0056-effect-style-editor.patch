diff --git a/src/components/properties/shared-style/effect-draft.ts b/src/components/properties/shared-style/effect-draft.ts
new file mode 100644
--- /dev/null
+++ b/src/components/properties/shared-style/effect-draft.ts
@@ -0,0 +1,31 @@
+import { copyEffects, type Effect } from '@open-pencil/scene-graph'
+
+export interface EffectDraft {
+  source: Effect
+  type: Effect['type']
+  hex: string
+  alpha: string | number
+  x: string | number
+  y: string | number
+  radius: string | number
+  spread: string | number
+  visible: boolean
+}
+export function effectDrafts(effects: Effect[]): EffectDraft[] {
+  return copyEffects(effects).map(source => ({
+    source, type: source.type, visible: source.visible,
+    hex: [source.color.r, source.color.g, source.color.b].map(value => Math.round(value * 255).toString(16).padStart(2, '0')).join('').toUpperCase(),
+    alpha: source.color.a * 100, x: source.offset.x, y: source.offset.y, radius: source.radius, spread: source.spread
+  }))
+}
+export function readEffects(drafts: EffectDraft[]): Effect[] {
+  return drafts.map((draft, index) => {
+    const hex = draft.hex.trim().replace(/^#/, '')
+    const values = [draft.alpha, draft.x, draft.y, draft.radius, draft.spread]
+    const [alpha, x, y, radius, spread] = values.map(Number)
+    if (!/^[0-9a-f]{6}$/i.test(hex) || values.some(value => String(value).trim() === '') || ![alpha, x, y, radius, spread].every(Number.isFinite) || alpha < 0 || alpha > 100 || radius < 0) throw new Error(`效果 ${index + 1}：请填写有效颜色和数值，透明度为 0–100，模糊不能为负数`)
+    return { ...draft.source, type: draft.type, visible: draft.visible, offset: { x, y }, radius, spread,
+      color: { r: Number.parseInt(hex.slice(0, 2), 16) / 255, g: Number.parseInt(hex.slice(2, 4), 16) / 255, b: Number.parseInt(hex.slice(4, 6), 16) / 255, a: alpha / 100 }
+    }
+  })
+}
