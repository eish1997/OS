+/** Follow the workbench palette. Default page fills are presentation-only and are not written into the document. */
+export function applyHostCanvasTheme(background: string): void {
+  if (!/^#[\da-f]{6}$/i.test(background)) return
+  const color = parseColor(background)
+  const luminance = 0.2126 * color.r + 0.7152 * color.g + 0.0722 * color.b
+  hostBackground = { ...color, a: 1 }
+  hostTheme.value = luminance > 0.6 ? 'light' : 'dark'
+  paintHostPageBackground()
+}
+
+export function paintHostPageBackground(): void {
+  if (!hostBackground) return
+  const store = getActiveEditorStoreOrNull()
+  if (!store) return
+  const current = store.state.pageColor
+  const replaceable = defaultPageColors.some(color => nearColor(current, color)) || (paintedBackground !== null && nearColor(current, paintedBackground))
+  if (!replaceable) return
+  paintedBackground = hostBackground
+  if (nearColor(current, hostBackground)) return
+  store.state.pageColor = { ...hostBackground }
+  // Repaint keeps the pan snapshot, which still has the old white clear baked in.
+  store.requestRender()
+}
