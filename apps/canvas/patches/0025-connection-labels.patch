diff --git a/src/app/document/local-connection-label.ts b/src/app/document/local-connection-label.ts
new file mode 100644
--- /dev/null
+++ b/src/app/document/local-connection-label.ts
@@ -0,0 +1,36 @@
+import type { Editor } from '@open-pencil/core/editor'
+import { ensureGraphFonts } from '@/app/editor/fonts'
+import type { SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+
+const pending = new WeakMap<SceneGraph, Map<string, Promise<void>>>()
+export function waitForConnectionLabel(graph: SceneGraph, id: string) { return pending.get(graph)?.get(id) }
+
+const labelKey = 'os.canvas/connectionLabel'
+/** A real text child travels with the vector through copy, delete, history and FIG export. */
+export function syncConnectionLabel(editor: Editor, line: SceneNode, text = '') {
+  const graph = editor.graph
+  let child = graph.getChildren(line.id).find(node => node.pluginData.some(p => p.pluginId === 'os.canvas' && p.key === labelKey))
+  if (!child && !text) return
+  if (!child) child = graph.createNode('TEXT', line.id, {
+    name: '连接标签', width: 240, height: 36, fontSize: 14, fontFamily: 'Inter',
+    textAlignHorizontal: 'CENTER', textAutoResize: 'HEIGHT', locked: true,
+    fills: [{ type: 'SOLID', color: { r: 0.93, g: 0.93, b: 0.93, a: 1 }, opacity: 1, visible: true }],
+    pluginData: [{ pluginId: 'os.canvas', key: labelKey, value: '1' }]
+  })
+  const x = line.width / 2 - child.width / 2, y = line.height / 2 - child.height - 6
+  if (child.text === text && child.visible === Boolean(text) && Math.abs(child.x - x) < 0.00001 && Math.abs(child.y - y) < 0.00001) return
+  const changedText = child.text !== text
+  graph.updateNode(child.id, { text, visible: Boolean(text), x, y })
+  if (changedText && text) {
+    const id = child.id
+    const task = ensureGraphFonts(graph, [id], editor.renderer).then(() => {
+      if (editor.graph !== graph || graph.getNode(id)?.text !== text) return undefined
+      editor.runLayoutForNode(id)
+      editor.requestRender()
+      return undefined
+    }).catch(() => console.warn('连接标签字体加载失败，文字内容已保留。'))
+    const tasks = pending.get(graph) ?? new Map<string, Promise<void>>()
+    tasks.set(line.id, task); pending.set(graph, tasks)
+    void task.then(() => tasks.get(line.id) === task && tasks.delete(line.id))
+  }
+}
